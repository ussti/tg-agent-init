diff --git a/plugin/tests/chats/multichat-entrypoint-attach.test.ts b/plugin/tests/chats/multichat-entrypoint-attach.test.ts
new file mode 100644
index 0000000..3cbd1ac
--- /dev/null
+++ b/plugin/tests/chats/multichat-entrypoint-attach.test.ts
@@ -0,0 +1,279 @@
+// Tests for attach mode in src/chats/hooks/multichat-entrypoint.sh
+// (2026-09-22): the same inbox watcher, pointed at a tmux pane that
+// somebody else owns (the master agent session), with no `claude` spawn.
+//
+// This is the transport private DMs use now — the MCP notification that
+// used to carry them drops text into the composer with no confirmation
+// that Enter ever landed, and six of the operator's messages died that
+// way between 20 and 22 Sep 2026.
+//
+// The script runs as a real process here (not sourced) with a stub tmux
+// and a stub claude on PATH, so we can assert both what it injected and
+// that it never launched a second Claude session.
+
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test'
+import { spawnSync } from 'child_process'
+import {
+  chmodSync,
+  existsSync,
+  mkdirSync,
+  mkdtempSync,
+  readFileSync,
+  readdirSync,
+  rmSync,
+  writeFileSync,
+} from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+
+const SCRIPT = join(
+  import.meta.dir,
+  '..',
+  '..',
+  'src',
+  'chats',
+  'hooks',
+  'multichat-entrypoint.sh',
+)
+
+const CHAT_ID = '100000001'
+const READY_PANE = '❯ \n⏵⏵ bypass permissions on (shift+tab to cycle)\n'
+
+let dir: string
+
+beforeEach(() => {
+  dir = mkdtempSync(join(tmpdir(), 'entrypoint-attach-'))
+  mkdirSync(join(dir, 'bin'), { recursive: true })
+})
+
+afterEach(() => {
+  rmSync(dir, { recursive: true, force: true })
+})
+
+function inboxDir(): string {
+  return join(dir, 'state', 'chats', CHAT_ID, 'inbox')
+}
+
+// Stub tmux: logs every call, serves a ready pane for capture-pane, and
+// answers `display-message` (the pane-liveness probe) with success for
+// the first TMUX_STUB_ALIVE_CALLS invocations and failure afterwards —
+// that is how a test ends the watcher loop deterministically.
+function installStubs(): void {
+  const tmux = `#!/usr/bin/env bash
+DIR="$(cd "$(dirname "\${BASH_SOURCE[0]}")/.." && pwd)"
+echo "$@" >> "$DIR/tmux.log"
+if [[ "$1" == "display-message" ]]; then
+  n=$(cat "$DIR/alive-count" 2>/dev/null || echo 0)
+  n=$((n + 1))
+  echo "$n" > "$DIR/alive-count"
+  [[ "$n" -le "\${TMUX_STUB_ALIVE_CALLS:-2}" ]] || exit 1
+  echo '%7'
+  exit 0
+fi
+if [[ "$1" == "capture-pane" ]]; then
+  cat "$DIR/pane.txt" 2>/dev/null || true
+fi
+if [[ "$1" == "load-buffer" ]]; then
+  cat > "$DIR/loaded-buffer.txt"
+fi
+if [[ "$1" == "paste-buffer" ]]; then
+  # Model the composer: a paste echoes into the pane unless the test
+  # asks for a swallowed paste (TMUX_STUB_NO_ECHO=1 — a modal holding
+  # the keyboard).
+  if [[ "\${TMUX_STUB_NO_ECHO:-0}" != "1" ]]; then
+    cat "$DIR/loaded-buffer.txt" >> "$DIR/pane.txt"
+  fi
+fi
+if [[ "$1" == "send-keys" && "$*" == *Enter* ]]; then
+  # Submit clears the composer back to an empty ready prompt.
+  if [[ "\${TMUX_STUB_ENTER_NOOP:-0}" != "1" ]]; then
+    printf '%s' "$(cat "$DIR/ready-pane.txt")" > "$DIR/pane.txt"
+  fi
+fi
+exit 0
+`
+  writeFileSync(join(dir, 'bin', 'tmux'), tmux)
+  chmodSync(join(dir, 'bin', 'tmux'), 0o755)
+
+  // A `claude` that only records the fact it was started. Attach mode
+  // must never reach it.
+  const claude = `#!/usr/bin/env bash
+DIR="$(cd "$(dirname "\${BASH_SOURCE[0]}")/.." && pwd)"
+echo started >> "$DIR/claude-started"
+exit 0
+`
+  writeFileSync(join(dir, 'bin', 'claude'), claude)
+  chmodSync(join(dir, 'bin', 'claude'), 0o755)
+
+  writeFileSync(join(dir, 'pane.txt'), READY_PANE)
+  writeFileSync(join(dir, 'ready-pane.txt'), READY_PANE)
+}
+
+function runAttach(
+  extraEnv: Record<string, string> = {},
+): { code: number; stdout: string; stderr: string } {
+  const res = spawnSync('bash', [SCRIPT], {
+    env: {
+      ...process.env,
+      PATH: `${join(dir, 'bin')}:${process.env['PATH'] ?? ''}`,
+      CHAT_ID,
+      MULTICHAT_STATE_DIR: join(dir, 'state'),
+      MULTICHAT_WATCH_ONLY: '1',
+      MULTICHAT_TARGET_PANE: 'agent-plugin',
+      MULTICHAT_ATTACH_POLL_TIMEOUT: '1',
+      MULTICHAT_READY_POLL_INTERVAL: '0.01',
+      MULTICHAT_READY_POLL_MAX: '5',
+      MULTICHAT_PASTE_SETTLE: '0.01',
+      MULTICHAT_SUBMIT_RETRY_DELAY: '0.01',
+      MULTICHAT_SUBMIT_RETRY_FACTOR: '1.0',
+      MULTICHAT_SUBMIT_RETRY_MAX: '3',
+      MULTICHAT_ECHO_POLL_INTERVAL: '0.01',
+      MULTICHAT_ECHO_POLL_MAX: '3',
+      ...extraEnv,
+    },
+    encoding: 'utf8',
+    timeout: 20_000,
+  })
+  return { code: res.status ?? -1, stdout: res.stdout ?? '', stderr: res.stderr ?? '' }
+}
+
+function tmuxLog(): string[] {
+  try {
+    return readFileSync(join(dir, 'tmux.log'), 'utf8').trim().split('\n')
+  } catch {
+    return []
+  }
+}
+
+function writeInboxMessage(text: string, name = `${Date.now()}-a.json`): void {
+  mkdirSync(inboxDir(), { recursive: true })
+  writeFileSync(
+    join(inboxDir(), name),
+    JSON.stringify({ text, chat_id: CHAT_ID, user_id: '1', user: '' }),
+  )
+}
+
+function channelBlock(messageId: string, body: string): string {
+  return (
+    `<channel source="telegram" chat_id="${CHAT_ID}" user_id="1" ` +
+    `ts="2026-09-22T05:00:00.000Z" message_id="${messageId}"> ${body} </channel>`
+  )
+}
+
+function queuedJson(): string[] {
+  return readdirSync(inboxDir()).filter((f) => f.endsWith('.json'))
+}
+
+function processedNames(): string[] {
+  const p = join(inboxDir(), '.processed')
+  return existsSync(p) ? readdirSync(p) : []
+}
+
+describe('multichat-entrypoint attach mode', () => {
+  test('refuses to start without a target pane', () => {
+    installStubs()
+    const res = runAttach({ MULTICHAT_TARGET_PANE: '' })
+    expect(res.code).toBe(2)
+    expect(res.stderr).toContain('MULTICHAT_TARGET_PANE not set')
+    expect(existsSync(join(dir, 'claude-started'))).toBe(false)
+  })
+
+  test('refuses to start when the target pane is gone', () => {
+    installStubs()
+    const res = runAttach({ TMUX_STUB_ALIVE_CALLS: '0' })
+    expect(res.code).toBe(2)
+    expect(res.stderr).toContain('not found')
+    expect(existsSync(join(dir, 'claude-started'))).toBe(false)
+  })
+
+  test('injects a pending message and never spawns claude', () => {
+    installStubs()
+    writeInboxMessage(channelBlock('11752', 'привет'))
+    const res = runAttach()
+    expect(res.code).toBe(0)
+
+    const log = tmuxLog()
+    expect(log.some((l) => l.startsWith('load-buffer'))).toBe(true)
+    expect(log.some((l) => l.includes('Enter'))).toBe(true)
+    // The pasted body is the channel payload verbatim — the session needs
+    // the chat_id in it to answer with the reply tool.
+    const pasted = readFileSync(join(dir, 'loaded-buffer.txt'), 'utf8')
+    expect(pasted).toContain('chat_id="100000001"')
+    expect(pasted).toContain('привет')
+
+    // Delivered → moved out of the inbox, into .processed/ unprefixed.
+    expect(readdirSync(inboxDir()).filter((f) => f.endsWith('.json'))).toEqual([])
+    const processed = readdirSync(join(inboxDir(), '.processed'))
+    expect(processed.length).toBe(1)
+    expect(processed[0]?.startsWith('submit-unconfirmed-')).toBe(false)
+
+    expect(existsSync(join(dir, 'claude-started'))).toBe(false)
+  })
+
+  test('exits when the target pane dies instead of eating the inbox', () => {
+    installStubs()
+    const res = runAttach({ TMUX_STUB_ALIVE_CALLS: '1' })
+    expect(res.code).toBe(0)
+    // A message that arrives after the watcher is gone stays untouched.
+    writeInboxMessage('поздно')
+    expect(readdirSync(inboxDir()).filter((f) => f.endsWith('.json')).length).toBe(1)
+  })
+
+  test('a modal over the composer defers injection instead of eating the file', () => {
+    installStubs()
+    // No `❯` anywhere: a survey / trust prompt / picker owns the keyboard.
+    writeFileSync(join(dir, 'pane.txt'), 'Do you trust the files in this folder?\n1. Yes\n2. No\n')
+    writeInboxMessage(channelBlock('11752', 'привет'))
+    const res = runAttach()
+    expect(res.code).toBe(0)
+    expect(res.stderr).toContain('composer not accepting input')
+    // Still queued — nothing was typed, so the next pass can retry it.
+    expect(queuedJson().length).toBe(1)
+    expect(processedNames()).toEqual([])
+    expect(tmuxLog().some((l) => l.includes('Enter'))).toBe(false)
+  })
+
+  test('a paste the pane never echoes does not get an Enter', () => {
+    installStubs()
+    writeInboxMessage(channelBlock('11753', 'привет'))
+    const res = runAttach({ TMUX_STUB_NO_ECHO: '1' })
+    expect(res.code).toBe(0)
+    expect(res.stderr).toContain('refusing to press Enter')
+    expect(tmuxLog().some((l) => l.includes('Enter'))).toBe(false)
+    // Pasted once, never re-pasted: the file is marked, not requeued.
+    expect(queuedJson()).toEqual([])
+    expect(processedNames()[0]?.startsWith('submit-unconfirmed-')).toBe(true)
+  })
+
+  test('two messages from the same chat get distinct fingerprints', () => {
+    installStubs()
+    writeInboxMessage(channelBlock('11752', 'первое'), '1000-a.json')
+    writeInboxMessage(channelBlock('11753', 'второе'), '1001-b.json')
+    const res = runAttach()
+    expect(res.code).toBe(0)
+    // Both confirmed: the constant `<channel source=…` prefix is not what
+    // the verifier watches — message_id is, so B cannot match A's echo.
+    expect(queuedJson()).toEqual([])
+    const processed = processedNames()
+    expect(processed.length).toBe(2)
+    expect(processed.some((f) => f.startsWith('submit-unconfirmed-'))).toBe(false)
+  })
+
+  test('an unconfirmed Enter marks the file rather than claiming success', () => {
+    installStubs()
+    writeInboxMessage(channelBlock('11754', 'привет'))
+    // Enter does nothing: the fingerprint stays on the pane and no
+    // generation starts — exactly the deaf-TUI state.
+    const res = runAttach({ TMUX_STUB_ENTER_NOOP: '1' })
+    expect(res.code).toBe(0)
+    expect(res.stderr).toContain('submit not confirmed')
+    expect(processedNames()[0]?.startsWith('submit-unconfirmed-')).toBe(true)
+  })
+
+  test('still refuses to start without CHAT_ID', () => {
+    installStubs()
+    const res = runAttach({ CHAT_ID: '' })
+    expect(res.code).toBe(2)
+    expect(res.stderr).toContain('refusing to start')
+  })
+})
