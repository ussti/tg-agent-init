@@ -0,0 +1,107 @@
+// DM delivery over the multichat file inbox (2026-09-22).
+//
+// Background. Private DMs have always been handed to the master Claude
+// session as an MCP notification (`sendChannelNotification`). The Claude
+// Code client turns that notification into text in the session composer —
+// and when the composer's Enter does not land (TUI busy, paste-burst
+// grouping, boot race) the message is simply lost: nothing retries, and
+// the plugin has already reported success. Six owner messages died
+// that way between 20 and 22 Sep 2026.
+//
+// Group chats never had that failure mode, because the multichat router
+// delivers them as a JSON file in `{stateDir}/chats/{chatId}/inbox/` and
+// an in-session watcher injects it with a bracketed paste plus a VERIFIED
+// Enter (see chats/hooks/multichat-entrypoint.sh). This module gives DMs
+// the same transport without the rest of multichat: no per-chat tmux
+// session is spawned — the watcher runs in attach mode against the master
+// session's pane, which is where the DM must land.
+//
+// Payload contract: `text` carries the whole `<channel …>` block — the
+// wrapper Claude Code itself renders from an MCP notification's meta,
+// reproduced here around the same `content`, and `user` is left empty so
+// the watcher's build_prompt emits that string verbatim instead of
+// prefixing its own `[from @…]` attribution. The session therefore sees
+// the same prompt shape on either transport, including the chat_id it
+// needs for the reply tool. Group chats do not need this: their session
+// is per-chat and carries CHAT_ID in its own environment, while a DM
+// lands in the master session, which knows only what the prompt says.
+
+import {
+  ensureChatStateDirs,
+  writeToInbox,
+  type InboundMessage,
+} from '../router/inbox-bridge.js'
+import type { Logger } from '../log.js'
+
+export interface DmInboxDeliveryOptions {
+  stateDir: string
+  chatId: string
+  userId: string
+  /** Channel body — exactly what the MCP notification would carry. */
+  content: string
+  /** Channel meta — the attributes of the `<channel …>` tag. */
+  meta: Record<string, string>
+  messageId?: string
+  log: Logger
+}
+
+function escapeAttr(value: string): string {
+  return value
+    .replace(/&/g, '&amp;')
+    .replace(/</g, '&lt;')
+    .replace(/>/g, '&gt;')
+    .replace(/"/g, '&quot;')
+}
+
+/**
+ * Render the `<channel …>` block the master session expects.
+ *
+ * Mirrors what Claude Code builds from a `notifications/claude/channel`
+ * event: the meta map becomes the tag's attributes, the content becomes
+ * its body. Meta values are already normalized to strings by the caller
+ * (see channel/notify.ts), so the only work here is attribute escaping.
+ */
+export function renderChannelBlock(
+  content: string,
+  meta: Record<string, string>,
+): string {
+  const attrs = Object.entries(meta)
+    .map(([key, value]) => `${key}="${escapeAttr(value)}"`)
+    .join(' ')
+  return `<channel ${attrs}> ${content} </channel>`
+}
+
+/**
+ * Write one DM into the chat's file inbox.
+ *
+ * Returns `true` when the file is committed (rename done — the watcher
+ * can no longer miss it). Returns `false` on any failure so the caller
+ * can fall back to the legacy MCP notify path: a degraded delivery beats
+ * a dropped one.
+ */
+export async function deliverDmToInbox(
+  opts: DmInboxDeliveryOptions,
+): Promise<boolean> {
+  const { stateDir, chatId, userId, content, meta, messageId, log } = opts
+  try {
+    await ensureChatStateDirs(chatId, stateDir)
+    const message: InboundMessage = {
+      text: renderChannelBlock(content, meta),
+      chat_id: chatId,
+      user_id: userId,
+      // Deliberately empty — see the payload contract above.
+      user: '',
+      timestamp: new Date().toISOString(),
+      ...(messageId !== undefined ? { message_id: messageId } : {}),
+    }
+    const path = await writeToInbox(chatId, message, stateDir)
+    log.info('dm delivered to inbox', { chat_id: chatId, path })
+    return true
+  } catch (err) {
+    log.error('dm inbox delivery failed — falling back to MCP notify', {
+      chat_id: chatId,
+      error: err instanceof Error ? err.message : String(err),
+    })
+    return false
+  }
+}
