@@ -0,0 +1,272 @@
+// DM delivery over the multichat file inbox (src/telegram/dm-inbox-delivery.ts)
+// plus the handler branch that prefers it (src/telegram/handlers.ts).
+//
+// The point of the transport: an MCP notification is fire-and-forget —
+// if the session composer never submits it, the message is gone and the
+// plugin still logged a success. The inbox file survives that, so the
+// watcher can retry the Enter. These tests pin the two invariants that
+// make the switch safe: a committed inbox write suppresses the legacy
+// notification (no double delivery), and a failed write does NOT (no
+// dropped delivery).
+
+import { describe, expect, test } from 'bun:test'
+import { existsSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+import type { Context } from 'grammy'
+
+import { deliverDmToInbox } from '../../src/telegram/dm-inbox-delivery.js'
+import { handleInboundText, type HandlerDeps } from '../../src/telegram/handlers.js'
+import type { AppConfig, StatePaths } from '../../src/config.js'
+import { createLogger } from '../../src/log.js'
+import type { TelegramApi } from '../../src/channel/tools.js'
+import type { BotIdentity } from '../../src/prompt/build.js'
+
+const silentLog = createLogger('test', {
+  stream: { write: () => true } as unknown as NodeJS.WritableStream,
+})
+
+const USER_ID = 164795011
+
+function makeConfig(overrides: Partial<AppConfig> = {}): AppConfig {
+  return {
+    bot_id: 8507713167,
+    dm_only: true,
+    allowed_user_ids: [USER_ID],
+    allowed_chat_ids: [USER_ID],
+    status: { enabled: false, interval_ms: 700, ttl_ms: 300_000, delete_on_complete: true, suppress_typing_bubble: false, simple_typing: false },
+    album: { flush_ms: 2000 },
+    voice: { provider: 'groq', language: 'ru', model: 'whisper-large-v3-turbo' },
+    webhook: { enabled: false, host: '127.0.0.1', port: 0 },
+    permission_relay: { enabled: false, allowed_user_ids: [USER_ID], bash_only_proof: true },
+    commands: { help: true, status: true, stop: true, reset: true, new: true },
+    memory: {
+      enabled: false,
+      source_tag: 'tg',
+      max_hot_bytes: 20480,
+      trim_keep_lines: 600,
+      buffer_ttl_ms: 5 * 60 * 1000,
+      buffer_max_entries: 100,
+    },
+    progress: { enabled: false, edit_throttle_ms: 3000, recent_buffer: 10, session_ttl_ms: 600000 },
+    task_mirror: { enabled: false, edit_throttle_ms: 3000, session_ttl_ms: 600000, collapse_completed_after: 5 },
+    watcher: { enabled: false, debounce_ms: 10_000, busy_threshold_ms: 30_000 },
+    tmux_mirror: { enabled: false, pane_target: '', socket_name: '', poll_interval_ms: 5000, line_count: 50, hide_segments: [], mode: 'latest_inbound_only', max_lines: 14 },
+    multichat: { enabled: false },
+    ask_user_question: { enabled: false, timeout_ms: 300_000, max_preview_chars: 1000 },
+    permission_gate: { enabled: false, timeout_ms: 120_000 },
+    richMessages: { enabled: false, perChatOptOut: [] },
+    ...overrides,
+  }
+}
+
+function makeStatePaths(): StatePaths {
+  const root = mkdtempSync(join(tmpdir(), 'dm-inbox-test-'))
+  return {
+    root,
+    env: join(root, '.env'),
+    config: join(root, 'config.json'),
+    allowlist: join(root, 'allowlist.json'),
+    pid: join(root, 'bot.pid'),
+    lock: join(root, 'bot.lock'),
+    updateOffset: join(root, 'update-offset'),
+    inbox: join(root, 'inbox'),
+    sessionIds: join(root, 'session-ids'),
+    deadLetterUpdates: join(root, 'dead-letter', 'updates'),
+    deadLetterWebhook: join(root, 'dead-letter', 'webhook'),
+    deadLetterOutbound: join(root, 'dead-letter', 'outbound'),
+    logs: {
+      server: join(root, 'logs', 'server.log'),
+      telegram: join(root, 'logs', 'telegram.log'),
+      permissions: join(root, 'logs', 'permissions.jsonl'),
+      webhook: join(root, 'logs', 'webhook.log'),
+      ask_user_question: join(root, 'logs', 'ask-user-question.jsonl'),
+      permission_gate: join(root, 'logs', 'permission-gate.jsonl'),
+    },
+  }
+}
+
+function noopApi(): TelegramApi {
+  const noop = async (): Promise<never> => {
+    throw new Error('unexpected api call in dm inbox test')
+  }
+  return {
+    sendMessage: noop as unknown as TelegramApi['sendMessage'],
+    sendRichMessage: noop as unknown as TelegramApi['sendRichMessage'],
+    editMessageText: noop as unknown as TelegramApi['editMessageText'],
+    setMessageReaction: async () => {},
+    sendChatAction: async () => {},
+    sendDocument: noop as unknown as TelegramApi['sendDocument'],
+    sendPhoto: noop as unknown as TelegramApi['sendPhoto'],
+    downloadFile: noop as unknown as TelegramApi['downloadFile'],
+    deleteMessage: noop as unknown as TelegramApi['deleteMessage'],
+    answerGuestQuery: noop as unknown as TelegramApi['answerGuestQuery'],
+  }
+}
+
+function makeDeps(dmInboxStateDir?: string, dmInboxChatIds: string[] = [String(USER_ID)]): {
+  deps: HandlerDeps
+  notifications: Array<{ method: string; params: unknown }>
+  statePaths: StatePaths
+} {
+  const notifications: Array<{ method: string; params: unknown }> = []
+  const statePaths = makeStatePaths()
+  const bot: BotIdentity = { id: 8507713167, username: 'canarybot' }
+  const deps: HandlerDeps = {
+    server: {
+      notification: async (msg: { method: string; params: unknown }): Promise<void> => {
+        notifications.push({ method: msg.method, params: msg.params })
+      },
+      // eslint-disable-next-line @typescript-eslint/no-explicit-any
+    } as any,
+    config: makeConfig(),
+    statePaths,
+    telegramApi: noopApi(),
+    log: silentLog,
+    bot,
+    botApi: { api: {} } as unknown as HandlerDeps['botApi'],
+    botToken: 'stub-value-for-tests',
+    env: {},
+    ...(dmInboxStateDir !== undefined ? { dmInboxStateDir, dmInboxChatIds } : {}),
+  }
+  return { deps, notifications, statePaths }
+}
+
+function makeCtx(text: string, chatType: 'private' | 'supergroup' = 'private'): Context {
+  return {
+    chat: { id: USER_ID, type: chatType },
+    from: { id: USER_ID, is_bot: false, first_name: 'Owner' },
+    message: {
+      message_id: 4242,
+      date: 1700000000,
+      text,
+      chat: { id: USER_ID, type: chatType },
+      from: { id: USER_ID, is_bot: false, first_name: 'Owner' },
+    },
+  } as unknown as Context
+}
+
+function inboxFiles(stateDir: string): string[] {
+  const dir = join(stateDir, 'chats', String(USER_ID), 'inbox')
+  return readdirSync(dir).filter((f) => f.endsWith('.json'))
+}
+
+function readInbox(stateDir: string): Record<string, unknown> {
+  const dir = join(stateDir, 'chats', String(USER_ID), 'inbox')
+  const files = inboxFiles(stateDir)
+  return JSON.parse(readFileSync(join(dir, files[0]!), 'utf8')) as Record<string, unknown>
+}
+
+describe('deliverDmToInbox', () => {
+  test('commits a rendered channel block, with no user attribution', async () => {
+    const stateDir = mkdtempSync(join(tmpdir(), 'dm-state-'))
+    const ok = await deliverDmToInbox({
+      stateDir,
+      chatId: String(USER_ID),
+      userId: String(USER_ID),
+      content: 'привет',
+      meta: {
+        source: 'telegram',
+        chat_id: String(USER_ID),
+        user: 'owner & co',
+        ts: '2026-09-22T05:00:00.000Z',
+      },
+      messageId: '4242',
+      log: silentLog,
+    })
+    expect(ok).toBe(true)
+    const msg = readInbox(stateDir)
+    // Same shape the MCP path produces — the session reads chat_id out of
+    // this tag to answer with the reply tool. Attribute values escaped.
+    expect(msg['text']).toBe(
+      '<channel source="telegram" chat_id="164795011" user="owner &amp; co" ' +
+        'ts="2026-09-22T05:00:00.000Z"> привет </channel>',
+    )
+    // Empty user => build_prompt emits the text without a `[from @…]` prefix.
+    expect(msg['user']).toBe('')
+    expect(msg['chat_id']).toBe(String(USER_ID))
+    expect(msg['message_id']).toBe('4242')
+    rmSync(stateDir, { recursive: true, force: true })
+  })
+
+  test('returns false instead of throwing when the inbox cannot be written', async () => {
+    // A regular file where the state dir should be — ensureChatStateDirs fails.
+    const blocker = join(mkdtempSync(join(tmpdir(), 'dm-state-')), 'not-a-dir')
+    writeFileSync(blocker, 'x')
+    const ok = await deliverDmToInbox({
+      stateDir: blocker,
+      chatId: String(USER_ID),
+      userId: String(USER_ID),
+      content: 'x',
+      meta: { source: 'telegram', chat_id: String(USER_ID) },
+      log: silentLog,
+    })
+    expect(ok).toBe(false)
+  })
+})
+
+describe('handleInboundText — DM transport selection', () => {
+  test('inbox mode: DM goes to the file inbox and NOT to the MCP notification', async () => {
+    const stateDir = mkdtempSync(join(tmpdir(), 'dm-state-'))
+    const { deps, notifications, statePaths } = makeDeps(stateDir)
+
+    await handleInboundText(makeCtx('привет'), deps)
+
+    expect(notifications.length).toBe(0)
+    const msg = readInbox(stateDir)
+    expect(String(msg['text'])).toContain('привет')
+    expect(String(msg['text'])).toContain('chat_id="164795011"')
+    rmSync(stateDir, { recursive: true, force: true })
+    rmSync(statePaths.root, { recursive: true, force: true })
+  })
+
+  test('falls back to the MCP notification when the inbox write fails', async () => {
+    const blocker = join(mkdtempSync(join(tmpdir(), 'dm-state-')), 'not-a-dir')
+    writeFileSync(blocker, 'x')
+    const { deps, notifications, statePaths } = makeDeps(blocker)
+
+    await handleInboundText(makeCtx('привет'), deps)
+
+    expect(notifications.length).toBe(1)
+    rmSync(statePaths.root, { recursive: true, force: true })
+  })
+
+  test('chat not in the watched list stays on the MCP notification', async () => {
+    // No watcher drains this chat's inbox, so a file written there would
+    // never be read AND the notify fallback would be suppressed — the
+    // exact silent-loss bug the transport exists to remove.
+    const stateDir = mkdtempSync(join(tmpdir(), 'dm-state-'))
+    const { deps, notifications, statePaths } = makeDeps(stateDir, ['999000111'])
+
+    await handleInboundText(makeCtx('привет'), deps)
+
+    expect(notifications.length).toBe(1)
+    expect(existsSync(join(stateDir, 'chats', String(USER_ID), 'inbox'))).toBe(false)
+    rmSync(stateDir, { recursive: true, force: true })
+    rmSync(statePaths.root, { recursive: true, force: true })
+  })
+
+  test('group message in inbox mode still uses the MCP notification', async () => {
+    const stateDir = mkdtempSync(join(tmpdir(), 'dm-state-'))
+    const { deps, notifications, statePaths } = makeDeps(stateDir)
+    deps.config.dm_only = false
+
+    await handleInboundText(makeCtx('привет', 'supergroup'), deps)
+
+    // Whatever the group routing decides (mention gating, outbox), it must
+    // never be the DM inbox — that transport is private-chat only.
+    expect(existsSync(join(stateDir, 'chats', String(USER_ID), 'inbox'))).toBe(false)
+    expect(notifications.length).toBeLessThanOrEqual(1)
+    rmSync(stateDir, { recursive: true, force: true })
+    rmSync(statePaths.root, { recursive: true, force: true })
+  })
+
+  test('notify mode (no state dir configured) is unchanged', async () => {
+    const { deps, notifications, statePaths } = makeDeps()
+
+    await handleInboundText(makeCtx('привет'), deps)
+
+    expect(notifications.length).toBe(1)
+    rmSync(statePaths.root, { recursive: true, force: true })
+  })
+})
