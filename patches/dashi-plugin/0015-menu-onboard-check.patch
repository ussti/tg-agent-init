--- /dev/null
+++ b/plugin/tests/commands/oob-menu.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, test } from 'bun:test'
+
+import {
+  AGENT_MENU_COMMANDS,
+  BOT_COMMANDS,
+  MENU_COMMANDS,
+  parseOobCommand,
+} from '../../src/commands/oob.js'
+
+describe('«/» menu', () => {
+  test('lists /onboard and /check after the plugin commands', () => {
+    const names = MENU_COMMANDS.map((c) => c.command)
+    expect(names.slice(0, BOT_COMMANDS.length)).toEqual(BOT_COMMANDS.map((c) => c.command))
+    expect(names.slice(BOT_COMMANDS.length)).toEqual(['onboard', 'check'])
+  })
+
+  test('agent commands pass through to the session', () => {
+    for (const c of AGENT_MENU_COMMANDS) {
+      expect(parseOobCommand(`/${c.command}`)).toBeNull()
+      expect(parseOobCommand(`/${c.command}@my_bot`)).toBeNull()
+    }
+  })
+
+  test('names are unique and valid for setMyCommands', () => {
+    const names = MENU_COMMANDS.map((c) => c.command)
+    expect(new Set(names).size).toBe(names.length)
+    for (const c of MENU_COMMANDS) {
+      expect(c.command).toMatch(/^[a-z0-9_]{1,32}$/)
+      expect(c.description.length).toBeGreaterThan(0)
+      expect(c.description.length).toBeLessThanOrEqual(256)
+    }
+  })
+})
