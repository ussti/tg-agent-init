Subject: [PATCH] меню «/»: команды агента /onboard и /check

Плагин при каждом старте стирает меню бота и записывает туда свой
список BOT_COMMANDS. Команды набора (/onboard, /check) работали, только
если набрать их руками, в меню их не было.

AGENT_MENU_COMMANDS добавляет их в меню после команд плагина. В
KNOWN_COMMANDS они не входят, поэтому нажатие доходит до сессии
обычным сообщением, как ручной набор. Меню по-прежнему видно только
владельцу (registerOwnerScopedCommands не менялся).

--- a/plugin/src/commands/oob.ts
+++ b/plugin/src/commands/oob.ts
@@ -258,6 +258,20 @@
   { command: 'lease', description: 'выдать мандат автономии: /lease <scope>[; ttl=48h]' },
 ]
 
+// Agent commands shown in the «/» menu next to BOT_COMMANDS. They are NOT in
+// KNOWN_COMMANDS: parseOobCommand returns null, so a tap reaches the agent
+// session as an ordinary message, exactly like typing the command by hand.
+export const AGENT_MENU_COMMANDS: ReadonlyArray<BotCommandSpec> = [
+  { command: 'onboard', description: 'настроить агента под себя: пять вопросов' },
+  { command: 'check', description: 'проверить, что всё работает' },
+]
+
+// The full «/» menu: plugin commands first, then the agent's own.
+export const MENU_COMMANDS: ReadonlyArray<BotCommandSpec> = [
+  ...BOT_COMMANDS,
+  ...AGENT_MENU_COMMANDS,
+]
+
