Upstream вернул SECRET_PATH_*_RE к жадному \S+ — он съедал </code> в
обёрнутых путях (инцидент 27/05), оставляя незакрытый тег → Telegram
html-validator downgrade. Восстановил char class [^\s<>"'] на обоих
правилах. Тест tests/safety/redact.test.ts:106 снова зелёный.

Co-Authored-By: Claude Opus 4.8 <noreply@anthropic.com>
---
 plugin/src/safety/redact.ts | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/plugin/src/safety/redact.ts b/plugin/src/safety/redact.ts
index 899b30a..377e419 100644
--- a/plugin/src/safety/redact.ts
+++ b/plugin/src/safety/redact.ts
@@ -133,8 +133,12 @@ function ipv4Replacer(full: string, first: string, last: string): string {
 //   2. anchored `secrets/<file>` — catches collapsed summaries like
 //      `secrets/openviking.key`. Must match at string start OR after a
 //      whitespace/path separator so we don't mangle `my-secrets/x`.
-const SECRET_PATH_TILDE_RE = /(~\/?\.\w+\/)secrets\/\S+/g
-const SECRET_PATH_ANCHORED_RE = /(^|[\s/])secrets\/\S+/g
+// Char class stops at `< > " '` (not bare `\S+`) so a path wrapped in
+// `<code>…</code>` doesn't swallow the closing tag → unclosed HTML →
+// Telegram html-validator downgrade (27/05 incident). Reapplied after the
+// 2026-06-18 upstream merge reverted it to `\S+`.
+const SECRET_PATH_TILDE_RE = /(~\/?\.\w+\/)secrets\/[^\s<>"']+/g
+const SECRET_PATH_ANCHORED_RE = /(^|[\s/])secrets\/[^\s<>"']+/g
 
 // Supabase project host: `<projectid>.supabase.co`. The callback masks the
 // inner project-id segment while leaving `.supabase.co` intact so the
