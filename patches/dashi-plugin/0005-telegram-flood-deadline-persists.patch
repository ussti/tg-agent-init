+// Durable Telegram flood deadlines, shared between the plugin and any external
+// sender (relay hook, flush cron).
+//
+// Why this file exists (incident 2026-07-31): the flood latch in
+// rate-limited-telegram-api.ts lives in memory. Telegram banned an agent's bot
+// from a chat for 58436s — longer than the plugin's uptime. Every restart threw
+// the deadline away, so the first outbound send probed Bot API inside the still
+// open window, which is exactly what makes Telegram extend the ban. Anything
+// that sends on the bot's behalf must be able to read one shared truth.
+//
+// Format ({stateDir}/telegram-flood.json), deliberately trivial so a shell or
+// python tool can read it without a parser:
+//   { "version": 1, "chats": { "100000001": { "not_before_ms": 1785…, "updated_at": "ISO" } } }
+//
+// Writes are atomic (.tmp + rename on the same filesystem) and best-effort: a
+// failed write must never break an outbound path, it only costs us the
+// after-restart guarantee.
+
+import { mkdirSync, readFileSync, renameSync, writeFileSync } from 'node:fs'
+import { dirname, join } from 'node:path'
+
+export const FLOOD_STATE_FILENAME = 'telegram-flood.json'
+const VERSION = 1
+
+interface FloodEntry {
+  not_before_ms: number
+  updated_at: string
+}
+
+interface FloodFile {
+  version: number
+  chats: Record<string, FloodEntry>
+}
+
+function emptyFile(): FloodFile {
+  return { version: VERSION, chats: {} }
+}
+
+/** Parse the on-disk shape defensively: any damage reads as "no deadlines". */
+export function parseFloodFile(raw: string): FloodFile {
+  let data: unknown
+  try {
+    data = JSON.parse(raw)
+  } catch {
+    return emptyFile()
+  }
+  if (typeof data !== 'object' || data === null) return emptyFile()
+  const chatsRaw = (data as { chats?: unknown }).chats
+  if (typeof chatsRaw !== 'object' || chatsRaw === null) return emptyFile()
+  const chats: Record<string, FloodEntry> = {}
+  for (const [chatId, entry] of Object.entries(chatsRaw as Record<string, unknown>)) {
+    if (typeof entry !== 'object' || entry === null) continue
+    const ms = (entry as { not_before_ms?: unknown }).not_before_ms
+    if (typeof ms !== 'number' || !Number.isFinite(ms) || ms <= 0) continue
+    const updated = (entry as { updated_at?: unknown }).updated_at
+    chats[chatId] = {
+      not_before_ms: Math.floor(ms),
+      updated_at: typeof updated === 'string' ? updated : '',
+    }
+  }
+  return { version: VERSION, chats }
+}
+
+/** Drop deadlines that have already elapsed — keeps the file from growing. */
+export function pruneExpired(file: FloodFile, nowMs: number): FloodFile {
+  const chats: Record<string, FloodEntry> = {}
+  for (const [chatId, entry] of Object.entries(file.chats)) {
+    if (entry.not_before_ms > nowMs) chats[chatId] = entry
+  }
+  return { version: VERSION, chats }
+}
+
+/**
+ * Merge a newly learned deadline. Only ever EXTENDS: a later, shorter
+ * retry_after must not shorten a longer ban we already know about.
+ */
+export function withDeadline(
+  file: FloodFile,
+  chatId: string,
+  untilMs: number,
+  nowIso: string,
+): FloodFile {
+  const current = file.chats[chatId]?.not_before_ms ?? 0
+  if (untilMs <= current) return file
+  return {
+    version: VERSION,
+    chats: { ...file.chats, [chatId]: { not_before_ms: untilMs, updated_at: nowIso } },
+  }
+}
+
+export function floodStatePath(stateDir: string): string {
+  return join(stateDir, FLOOD_STATE_FILENAME)
+}
+
+/** Deadlines still in the future, as the rate limiter's initialFloodUntilMs. */
+export function loadFloodDeadlines(
+  stateDir: string,
+  nowMs: number = Date.now(),
+): Record<string, number> {
+  let raw: string
+  try {
+    raw = readFileSync(floodStatePath(stateDir), 'utf8')
+  } catch {
+    return {}
+  }
+  const pruned = pruneExpired(parseFloodFile(raw), nowMs)
+  const out: Record<string, number> = {}
+  for (const [chatId, entry] of Object.entries(pruned.chats)) {
+    out[chatId] = entry.not_before_ms
+  }
+  return out
+}
+
+/** Record a deadline. Best-effort, never throws. */
+export function saveFloodDeadline(
+  stateDir: string,
+  chatId: string,
+  untilMs: number,
+  nowMs: number = Date.now(),
+): void {
+  const path = floodStatePath(stateDir)
+  try {
+    mkdirSync(dirname(path), { recursive: true })
+    let current: FloodFile
+    try {
+      current = parseFloodFile(readFileSync(path, 'utf8'))
+    } catch {
+      current = emptyFile()
+    }
+    const next = pruneExpired(
+      withDeadline(current, chatId, untilMs, new Date(nowMs).toISOString()),
+      nowMs,
+    )
+    const tmp = `${path}.tmp`
+    writeFileSync(tmp, `${JSON.stringify(next, null, 2)}\n`, { mode: 0o600 })
+    renameSync(tmp, path)
+  } catch {
+    // Deliberately silent: see the header note on best-effort writes.
+  }
+}
