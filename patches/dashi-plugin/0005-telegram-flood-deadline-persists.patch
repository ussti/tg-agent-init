+// Tests for the durable flood-deadline store. Pure functions are exercised
+// directly; the load/save pair runs against a temp dir.
+
+import { describe, expect, test } from 'bun:test'
+import { mkdtempSync, readFileSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import {
+  floodStatePath,
+  loadFloodDeadlines,
+  parseFloodFile,
+  pruneExpired,
+  saveFloodDeadline,
+  withDeadline,
+} from '../../src/safety/flood-state.js'
+
+const NOW = 1_785_000_000_000
+const tmp = (): string => mkdtempSync(join(tmpdir(), 'flood-state-'))
+
+describe('parseFloodFile', () => {
+  test('reads a well-formed file', () => {
+    const raw = JSON.stringify({
+      version: 1,
+      chats: { '100000001': { not_before_ms: NOW + 1000, updated_at: 'x' } },
+    })
+    expect(parseFloodFile(raw).chats['100000001']?.not_before_ms).toBe(NOW + 1000)
+  })
+
+  test('garbage reads as empty, never throws', () => {
+    for (const raw of ['', 'not json', '[]', 'null', '{"chats":5}']) {
+      expect(parseFloodFile(raw).chats).toEqual({})
+    }
+  })
+
+  test('drops entries with a non-numeric or non-positive deadline', () => {
+    const raw = JSON.stringify({
+      chats: {
+        a: { not_before_ms: 'soon' },
+        b: { not_before_ms: 0 },
+        c: { not_before_ms: -5 },
+        d: { not_before_ms: NOW },
+      },
+    })
+    expect(Object.keys(parseFloodFile(raw).chats)).toEqual(['d'])
+  })
+})
+
+describe('withDeadline', () => {
+  test('records a new deadline', () => {
+    const f = withDeadline(parseFloodFile(''), '1', NOW + 500, 'iso')
+    expect(f.chats['1']?.not_before_ms).toBe(NOW + 500)
+  })
+
+  test('extends a longer ban but never shortens it', () => {
+    let f = withDeadline(parseFloodFile(''), '1', NOW + 50_000, 'iso')
+    f = withDeadline(f, '1', NOW + 1_000, 'iso') // a later, smaller retry_after
+    expect(f.chats['1']?.not_before_ms).toBe(NOW + 50_000)
+    f = withDeadline(f, '1', NOW + 90_000, 'iso')
+    expect(f.chats['1']?.not_before_ms).toBe(NOW + 90_000)
+  })
+
+  test('chats are independent', () => {
+    let f = withDeadline(parseFloodFile(''), '1', NOW + 100, 'iso')
+    f = withDeadline(f, '2', NOW + 200, 'iso')
+    expect(f.chats['1']?.not_before_ms).toBe(NOW + 100)
+    expect(f.chats['2']?.not_before_ms).toBe(NOW + 200)
+  })
+})
+
+describe('pruneExpired', () => {
+  test('removes elapsed deadlines, keeps future ones', () => {
+    let f = withDeadline(parseFloodFile(''), 'past', NOW - 1, 'iso')
+    f = withDeadline(f, 'future', NOW + 1, 'iso')
+    expect(Object.keys(pruneExpired(f, NOW).chats)).toEqual(['future'])
+  })
+})
+
+describe('load / save round trip', () => {
+  test('a saved deadline is restored', () => {
+    const dir = tmp()
+    saveFloodDeadline(dir, '100000001', NOW + 58_436_000, NOW)
+    expect(loadFloodDeadlines(dir, NOW)['100000001']).toBe(NOW + 58_436_000)
+  })
+
+  test('an elapsed deadline is not restored', () => {
+    const dir = tmp()
+    saveFloodDeadline(dir, '1', NOW + 1000, NOW)
+    expect(loadFloodDeadlines(dir, NOW + 2000)).toEqual({})
+  })
+
+  test('missing file reads as no deadlines', () => {
+    expect(loadFloodDeadlines(join(tmp(), 'nope'), NOW)).toEqual({})
+  })
+
+  test('corrupt file reads as no deadlines instead of throwing', () => {
+    const dir = tmp()
+    writeFileSync(floodStatePath(dir), '{ this is not json')
+    expect(loadFloodDeadlines(dir, NOW)).toEqual({})
+  })
+
+  test('the file is written 0600 and stays machine-readable', () => {
+    const dir = tmp()
+    saveFloodDeadline(dir, '1', NOW + 1000, NOW)
+    const parsed = JSON.parse(readFileSync(floodStatePath(dir), 'utf8'))
+    expect(parsed.version).toBe(1)
+    expect(parsed.chats['1'].not_before_ms).toBe(NOW + 1000)
+    expect(typeof parsed.chats['1'].updated_at).toBe('string')
+  })
+
+  test('saving twice keeps the longer ban', () => {
+    const dir = tmp()
+    saveFloodDeadline(dir, '1', NOW + 50_000, NOW)
+    saveFloodDeadline(dir, '1', NOW + 10_000, NOW)
+    expect(loadFloodDeadlines(dir, NOW)['1']).toBe(NOW + 50_000)
+  })
+
+  test('save never throws on an unwritable path', () => {
+    expect(() => saveFloodDeadline('/proc/nonexistent-dir', '1', NOW + 1, NOW)).not.toThrow()
+  })
+})
