+// Flood deadlines survive restarts (incident 2026-07-31: a 58436s ban outlived
+// two restarts, and each fresh process probed Bot API inside the open window,
+// which is what extends the ban). Restored on boot, persisted on every latch.
+const restoredFloodDeadlines = loadFloodDeadlines(statePaths.root)
+if (Object.keys(restoredFloodDeadlines).length > 0) {
+  log.warn('restored telegram flood deadlines', {
+    chats: Object.entries(restoredFloodDeadlines).map(([chatId, untilMs]) => ({
+      chat_id: chatId,
+      until: new Date(untilMs).toISOString(),
+    })),
+  })
+}
+const rateLimitedTelegramApi = createRateLimitedTelegramApi(rawTelegramApi, log, {
+  initialFloodUntilMs: restoredFloodDeadlines,
