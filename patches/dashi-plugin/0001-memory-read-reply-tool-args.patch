--- a/plugin/src/memory/transcript-reader.ts
+++ b/plugin/src/memory/transcript-reader.ts
@@ -1,28 +1,38 @@
-// Phase 8 / T5 — tail-read the last assistant text from a Claude
-// transcript JSONL file.
+// Phase 8 / T5 (PATCH-Y, 2026-05-23) — extract last `dashi-channel reply` tool
+// args from a Claude transcript JSONL file.
 //
-// Claude Code persists each session as `~/.claude/projects/<slug>/<sid>.jsonl`
-// with one JSON object per line. We're interested in the last line whose
-// `message.role === 'assistant'` and whose `message.content` array has
-// at least one `{type: 'text', text: ...}` block — that's the text the
-// user would have seen at the end of the turn. Tool-use only assistant
-// messages are skipped (they have content[].type === 'tool_use').
+// REPLACES the original readLastAssistantText. The old reader returned the
+// last assistant text block; broke when Claude finished a turn with a tool
+// call (no follow-up text) — returned PRIOR turn's text, causing
+// recent-plugin.md misalignment (5/5 in fast-fire burn-in 2026-05-23).
 //
-// Strategy: open the file, read at most the trailing TAIL_BYTES bytes
-// to keep memory bounded on multi-megabyte transcripts, drop the first
-// (possibly-truncated) line when we didn't start at byte 0, then walk
-// the lines backward and return the first parseable assistant text.
+// New strategy: walk transcript lines backward, find the last assistant
+// message containing a tool_use block where name === REPLY_TOOL_NAME,
+// return input.text (== exactly what was sent to Telegram).
 //
-// All errors are swallowed and surface as `null` — the caller treats
-// "no agent text" as "(inline)". Missing files, permission denied,
-// malformed JSON, schema drift — none of them should block the hot/
-// verbose writes for the user side.
+// Turn boundary: stop when we hit a REAL user message going backward. Reply
+// tool calls before that boundary belong to a prior turn — must NOT be
+// reported as this turn's answer. Returns null if current turn has no reply
+// (HARD RULE violation — caller emits forensic marker downstream).
+//
+// IMPORTANT: Claude Code writes tool_result responses as role='user'
+// messages with content[].type === 'tool_result'. Those are synthetic
+// (responses to assistant tool_use), NOT real turn boundaries — skip them.
+// A real user prompt has at least one non-tool_result block.
+//
+// MVP: returns LAST reply in turn. If Claude splits long answer into multiple
+// reply() calls, earlier chunks are dropped. Document only; extend to
+// concatenate-all if burn-in shows split-reply pattern.
+//
+// All errors swallowed → null. Defensive JSON.parse per-line (partial/
+// malformed lines skipped, never abort).
 
 import { open, type FileHandle } from 'node:fs/promises'
 
 const TAIL_BYTES = 256 * 1024
+const REPLY_TOOL_NAME = 'mcp__dashi-channel__reply'
 
-export async function readLastAssistantText(
+export async function readLastReplyToolArgs(
   transcriptPath: string,
 ): Promise<string | null> {
   let handle: FileHandle | undefined
@@ -36,52 +46,69 @@ export async function readLastAssistantText(
     await handle.read(buf, 0, len, start)
     const text = buf.toString('utf8')
 
-    // Drop possibly-truncated first chunk if we didn't start at byte 0;
-    // also filter empty lines so a trailing newline doesn't produce an
-    // empty parse attempt.
+    // Drop possibly-truncated first chunk if we didn't start at byte 0.
     const split = text.split('\n')
     const lines = (start > 0 ? split.slice(1) : split).filter((l) => l.length > 0)
 
+    // Walk backward. Stop at the first user message — that's the boundary of
+    // the CURRENT turn. Reply tool calls before that belong to prior turn.
     for (let i = lines.length - 1; i >= 0; i--) {
-      // Permissive parse: valid JSON with the wrong shape (null, a bare
-      // array, a string, …) used to bypass the per-line try/catch and
-      // throw at the next `obj.message?.role` access, escaping to the
-      // OUTER catch and short-circuiting earlier valid assistant text.
-      // Each line is now its own boundary — shape mismatch = skip, not
-      // abort.
       let obj: unknown
       try {
         obj = JSON.parse(lines[i]!)
       } catch {
+        // Partial/malformed line — skip defensively.
         continue
       }
       if (typeof obj !== 'object' || obj === null || Array.isArray(obj)) continue
       const msg = (obj as { message?: unknown }).message
       if (typeof msg !== 'object' || msg === null) continue
       const role = (msg as { role?: unknown }).role
-      if (role !== 'assistant') continue
       const content = (msg as { content?: unknown }).content
+
+      // Turn boundary (backward): first REAL user message ends search window.
+      // tool_result messages have role='user' but are synthetic responses to
+      // assistant tool_use — NOT real boundaries. A real user prompt has at
+      // least one block that is not a tool_result.
+      if (role === 'user') {
+        if (
+          Array.isArray(content) &&
+          content.length > 0 &&
+          content.every(
+            (c) =>
+              typeof c === 'object' &&
+              c !== null &&
+              (c as { type?: unknown }).type === 'tool_result',
+          )
+        ) {
+          continue
+        }
+        return null
+      }
+
+      if (role !== 'assistant') continue
       if (!Array.isArray(content)) continue
-      const parts: string[] = []
-      for (const c of content) {
+
+      // Find LAST reply tool_use in this assistant message (last-only MVP for
+      // multiple replies in one turn — extend to concat if pattern surfaces).
+      for (let j = content.length - 1; j >= 0; j--) {
+        const c = content[j]
         if (typeof c !== 'object' || c === null) continue
-        const block = c as { type?: unknown; text?: unknown }
-        if (block.type === 'text' && typeof block.text === 'string') {
-          parts.push(block.text)
-        }
+        const block = c as { type?: unknown; name?: unknown; input?: unknown }
+        if (block.type !== 'tool_use') continue
+        if (block.name !== REPLY_TOOL_NAME) continue
+        if (typeof block.input !== 'object' || block.input === null) continue
+        const replyInput = block.input as { text?: unknown }
+        if (typeof replyInput.text !== 'string') continue
+        return replyInput.text
       }
-      if (parts.length > 0) return parts.join('\n')
     }
     return null
   } catch {
     return null
   } finally {
     if (handle) {
-      try {
-        await handle.close()
-      } catch {
-        // close() race on an already-closed handle is harmless
-      }
+      try { await handle.close() } catch { /* harmless close-race */ }
     }
   }
 }
