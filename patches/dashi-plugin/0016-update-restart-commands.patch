+import { afterEach, beforeEach, describe, expect, test } from 'bun:test'
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+
+import {
+  SYSQ_PREFIX,
+  buildSysConfirmCard,
+  formatSelfUpdateReport,
+  handleSysqCallback,
+  launchSelfUpdate,
+  parseSysqCallback,
+  reportSelfUpdateResult,
+  resolveSelfUpdatePaths,
+  type SelfUpdatePaths,
+  type SpawnDetached,
+} from '../../src/commands/self-update.js'
+import { parseOobCommand, BOT_COMMANDS } from '../../src/commands/oob.js'
+
+const silentLog = {
+  info: () => {}, warn: () => {}, error: () => {}, debug: () => {},
+} as never
+
+let ws: string
+let paths: SelfUpdatePaths
+
+beforeEach(() => {
+  ws = mkdtempSync(join(tmpdir(), 'self-update-'))
+  mkdirSync(join(ws, 'bin'), { recursive: true })
+  mkdirSync(join(ws, 'logs'), { recursive: true })
+  writeFileSync(join(ws, 'bin', 'self-update.sh'), '#!/bin/sh\n')
+  const p = resolveSelfUpdatePaths({ AGENT_WS: ws, LOG_DIR: join(ws, 'logs') })
+  if (p === null) throw new Error('paths must resolve')
+  paths = p
+})
+
+afterEach(() => {
+  // temp dirs are left to the OS tmp cleaner
+})
+
+describe('commands', () => {
+  test('/update and /restart are plugin commands in the menu', () => {
+    expect(parseOobCommand('/update')?.name).toBe('update')
+    expect(parseOobCommand('/restart@bot')?.name).toBe('restart')
+    const names = BOT_COMMANDS.map((c) => c.command)
+    expect(names).toContain('update')
+    expect(names).toContain('restart')
+  })
+})
+
+describe('resolveSelfUpdatePaths', () => {
+  test('null without AGENT_WS', () => {
+    expect(resolveSelfUpdatePaths({})).toBeNull()
+  })
+
+  test('null when the wrapper script is missing', () => {
+    const empty = mkdtempSync(join(tmpdir(), 'self-update-empty-'))
+    expect(resolveSelfUpdatePaths({ AGENT_WS: empty })).toBeNull()
+  })
+
+  test('paths live under the workspace', () => {
+    expect(paths.script).toBe(join(ws, 'bin', 'self-update.sh'))
+    expect(paths.resultFile).toBe(join(ws, 'state', 'self-update.json'))
+    expect(paths.logFile).toBe(join(ws, 'logs', 'self-update.log'))
+  })
+})
+
+describe('confirm card + callback parsing', () => {
+  test('card carries action and nonce, fits 64 bytes', () => {
+    for (const action of ['update', 'restart'] as const) {
+      const card = buildSysConfirmCard(action)
+      const btns = card.inlineKeyboard.inline_keyboard.flat()
+      const data = btns.map((b) => b.callback_data ?? '')
+      expect(data[0]?.startsWith(`${SYSQ_PREFIX}${action}:`)).toBe(true)
+      expect(data[1]).toBe(`${SYSQ_PREFIX}cancel`)
+      for (const d of data) expect(Buffer.byteLength(d)).toBeLessThanOrEqual(64)
+      const parsed = parseSysqCallback(data[0] ?? '')
+      expect(parsed?.action).toBe(action)
+      expect(parsed?.ts).toBeGreaterThan(0)
+    }
+  })
+
+  test('rejects garbage', () => {
+    expect(parseSysqCallback('newq:confirm')).toBeNull()
+    expect(parseSysqCallback('sysq:wipe:1')).toBeNull()
+    expect(parseSysqCallback('sysq:update:abc')).toBeNull()
+    expect(parseSysqCallback('sysq:update')).toBeNull()
+    expect(parseSysqCallback('sysq:cancel')?.action).toBe('cancel')
+  })
+})
+
+describe('launchSelfUpdate', () => {
+  test('clears a stale result and spawns the wrapper detached', () => {
+    mkdirSync(join(ws, 'state'), { recursive: true })
+    writeFileSync(paths.resultFile, '{"action":"update","rc":0}')
+    const calls: Array<{ cmd: string; args: string[]; log: string; env: NodeJS.ProcessEnv }> = []
+    const spawn: SpawnDetached = (cmd, args, log, env) => {
+      calls.push({ cmd, args, log, env })
+    }
+    const res = launchSelfUpdate('update', paths, { spawn, env: { TMUX: 'x', A: '1' } })
+    expect(res.ok).toBe(true)
+    expect(existsSync(paths.resultFile)).toBe(false)
+    expect(calls).toHaveLength(1)
+    expect(calls[0]?.cmd).toBe('bash')
+    expect(calls[0]?.args).toEqual([paths.script, 'update'])
+    expect(calls[0]?.log).toBe(paths.logFile)
+    expect(calls[0]?.env.TMUX).toBeUndefined()
+    expect(calls[0]?.env.A).toBe('1')
+  })
+
+  test('refuses a second launch while one is running', () => {
+    const spawn: SpawnDetached = () => {}
+    mkdirSync(join(ws, 'state'), { recursive: true })
+    writeFileSync(paths.lockFile, String(Date.now()))
+    const res = launchSelfUpdate('restart', paths, { spawn, env: {} })
+    expect(res.ok).toBe(false)
+  })
+
+  test('a stale lock does not block', () => {
+    const spawn: SpawnDetached = () => {}
+    mkdirSync(join(ws, 'state'), { recursive: true })
+    writeFileSync(paths.lockFile, String(Date.now() - 60 * 60 * 1000))
+    expect(launchSelfUpdate('restart', paths, { spawn, env: {} }).ok).toBe(true)
+  })
+
+  test('spawn failure is reported, not thrown', () => {
+    const spawn: SpawnDetached = () => {
+      throw new Error('ENOENT')
+    }
+    const res = launchSelfUpdate('update', paths, { spawn, env: {} })
+    expect(res.ok).toBe(false)
+    expect(existsSync(paths.lockFile)).toBe(false)
+  })
+})
+
+describe('formatSelfUpdateReport', () => {
+  test('update ok names the version', () => {
+    const t = formatSelfUpdateReport({ action: 'update', rc: 0, version: 'abc1234' }, '')
+    expect(t).toContain('abc1234')
+    expect(t).not.toContain('<pre>')
+  })
+
+  test('update failure carries the escaped log tail', () => {
+    const t = formatSelfUpdateReport({ action: 'update', rc: 1, version: 'abc1234' }, 'boom <x>')
+    expect(t).toContain('<pre>boom &lt;x&gt;</pre>')
+  })
+
+  test('restart', () => {
+    expect(formatSelfUpdateReport({ action: 'restart', rc: 0 }, '')).toContain('Перезапустился')
+  })
+})
+
+describe('reportSelfUpdateResult', () => {
+  test('sends once and removes the result', async () => {
+    mkdirSync(join(ws, 'state'), { recursive: true })
+    writeFileSync(paths.resultFile, JSON.stringify({ action: 'restart', rc: 0, chat_id: '42' }))
+    writeFileSync(paths.lockFile, String(Date.now()))
+    const sent: Array<[string, string]> = []
+    const send = async (chatId: string, text: string): Promise<void> => {
+      sent.push([chatId, text])
+    }
+    expect(await reportSelfUpdateResult(paths, ['42'], send, silentLog)).toBe(true)
+    expect(await reportSelfUpdateResult(paths, ['42'], send, silentLog)).toBe(false)
+    expect(sent).toHaveLength(1)
+    expect(sent[0]?.[0]).toBe('42')
+    expect(existsSync(paths.resultFile)).toBe(false)
+    expect(existsSync(paths.lockFile)).toBe(false)
+  })
+
+  test('falls back to the first owner when the chat is not an owner', async () => {
+    mkdirSync(join(ws, 'state'), { recursive: true })
+    writeFileSync(paths.resultFile, JSON.stringify({ action: 'update', rc: 0, chat_id: '-100' }))
+    const sent: string[] = []
+    await reportSelfUpdateResult(paths, ['7'], async (c) => { sent.push(c) }, silentLog)
+    expect(sent).toEqual(['7'])
+  })
+
+  test('a corrupt result is dropped without sending', async () => {
+    mkdirSync(join(ws, 'state'), { recursive: true })
+    writeFileSync(paths.resultFile, 'not json')
+    const sent: string[] = []
+    expect(await reportSelfUpdateResult(paths, ['7'], async (c) => { sent.push(c) }, silentLog))
+      .toBe(false)
+    expect(sent).toEqual([])
+    expect(existsSync(paths.resultFile)).toBe(false)
+  })
+
+  test('no result → nothing', async () => {
+    expect(await reportSelfUpdateResult(paths, ['7'], async () => {}, silentLog)).toBe(false)
+  })
+})
+
+describe('handleSysqCallback', () => {
+  function mkCtx(data: string, fromId: number, chatId = String(fromId)) {
+    const acks: string[] = []
+    const edits: string[] = []
+    return {
+      acks,
+      edits,
+      ctx: {
+        callbackQuery: { data },
+        from: { id: fromId },
+        chatId,
+        answerCallbackQuery: async (arg?: { text: string }) => { acks.push(arg?.text ?? '') },
+        editMessageText: async (text: string) => { edits.push(text) },
+      },
+    }
+  }
+
+  test('non-allowed user: toast only, nothing launched', async () => {
+    let launched = 0
+    const card = buildSysConfirmCard('restart')
+    const data = card.inlineKeyboard.inline_keyboard[0]?.[0]?.callback_data ?? ''
+    const { ctx, edits } = mkCtx(data, 999)
+    await handleSysqCallback(ctx, {
+      allowedUserIds: [1], ownerChatIds: ['1'], paths, log: silentLog,
+      launch: () => { launched++; return { ok: true as const } },
+    })
+    expect(launched).toBe(0)
+    expect(edits).toEqual([])
+  })
+
+  test('confirm from the owner launches and records the chat', async () => {
+    const seen: Array<[string, string | undefined]> = []
+    const card = buildSysConfirmCard('update')
+    const data = card.inlineKeyboard.inline_keyboard[0]?.[0]?.callback_data ?? ''
+    const { ctx, edits } = mkCtx(data, 1)
+    await handleSysqCallback(ctx, {
+      allowedUserIds: [1], ownerChatIds: ['1'], paths, log: silentLog,
+      launch: (action, _p, opts) => { seen.push([action, opts.chatId]); return { ok: true as const } },
+    })
+    expect(seen).toEqual([['update', '1']])
+    expect(edits[0]).toContain('Обновляюсь')
+  })
+
+  test('double tap launches once', async () => {
+    let launched = 0
+    const card = buildSysConfirmCard('restart')
+    const data = card.inlineKeyboard.inline_keyboard[0]?.[0]?.callback_data ?? ''
+    const deps = {
+      allowedUserIds: [1], ownerChatIds: ['1'], paths, log: silentLog,
+      launch: () => { launched++; return { ok: true as const } },
+    }
+    await handleSysqCallback(mkCtx(data, 1).ctx, deps)
+    await handleSysqCallback(mkCtx(data, 1).ctx, deps)
+    expect(launched).toBe(1)
+  })
+
+  test('stale card refused', async () => {
+    let launched = 0
+    const { ctx, edits } = mkCtx(`${SYSQ_PREFIX}restart:${Date.now() - 10 * 60 * 1000}:aa`, 1)
+    await handleSysqCallback(ctx, {
+      allowedUserIds: [1], ownerChatIds: ['1'], paths, log: silentLog,
+      launch: () => { launched++; return { ok: true as const } },
+    })
+    expect(launched).toBe(0)
+    expect(edits[0]).toContain('устарел')
+  })
+
+  test('no wrapper on this install', async () => {
+    const card = buildSysConfirmCard('update')
+    const data = card.inlineKeyboard.inline_keyboard[0]?.[0]?.callback_data ?? ''
+    const { ctx, edits } = mkCtx(data, 1)
+    await handleSysqCallback(ctx, {
+      allowedUserIds: [1], ownerChatIds: ['1'], paths: null, log: silentLog,
+      launch: () => ({ ok: true as const }),
+    })
+    expect(edits[0]).toContain('update.sh')
+  })
+
+  test('cancel edits the card', async () => {
+    const { ctx, edits } = mkCtx(`${SYSQ_PREFIX}cancel`, 1)
+    await handleSysqCallback(ctx, {
+      allowedUserIds: [1], ownerChatIds: ['1'], paths, log: silentLog,
+      launch: () => ({ ok: true as const }),
+    })
+    expect(edits[0]).toContain('Отменено')
+  })
+})
+
+test('launch writes the requesting chat into the lock for the report', () => {
+  const spawn: SpawnDetached = () => {}
+  launchSelfUpdate('restart', paths, { spawn, env: {}, chatId: '55' })
