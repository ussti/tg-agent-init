diff -ruN a/plugin/src/commands/self-update.ts b/plugin/src/commands/self-update.ts
--- a/plugin/src/commands/self-update.ts
+++ b/plugin/src/commands/self-update.ts
@@ -0,0 +1,452 @@
+// /update and /restart — owner-only controls that update or restart the agent
+// from Telegram.
+//
+// Both are destructive for the running session (the plugin restarts), so a bare
+// command posts a confirm card; the tap launches `$AGENT_WS/bin/self-update.sh`
+// fully detached (setsid, own log, no TMUX in env). The unit has
+// KillMode=process, so the wrapper survives the restart it causes. The wrapper
+// writes `$AGENT_WS/state/self-update.json` when done; whichever plugin process
+// is alive then (the old one if the update failed before restart, the new one
+// after it) reports the result to the owner once and removes the file.
+//
+// Callback data uses the `sysq:` prefix, distinct from kkey:/ccmd:/pgate:/ask:/
+// newq:/hud:.
+//   sysq:update:<ts>:<rand>  — run update.sh
+//   sysq:restart:<ts>:<rand> — restart the agent unit
+//   sysq:cancel              — abort
+
+import { spawn } from 'node:child_process'
+import {
+  closeSync,
+  existsSync,
+  mkdirSync,
+  openSync,
+  readFileSync,
+  renameSync,
+  statSync,
+  unlinkSync,
+  writeFileSync,
+} from 'node:fs'
+import { dirname, join } from 'node:path'
+
+import type { InlineKeyboardLike } from '../channel/tools.js'
+import { escapeHtml } from '../format/html.js'
+import type { Logger } from '../log.js'
+import { createNewqNonceGuard, isOwnerDmChat, type NewqNonceGuard } from '../telegram/newq-confirm-ui.js'
+
+export const SYSQ_PREFIX = 'sysq:'
+// A card older than this cannot fire.
+export const SYSQ_TTL_MS = 2 * 60 * 1000
+// A lock older than this is a wrapper that died without writing a result.
+export const SYSQ_LOCK_STALE_MS = 20 * 60 * 1000
+// How long a plugin keeps looking for the result after launch or boot.
+export const SYSQ_WATCH_MS = 15 * 60 * 1000
+export const SYSQ_POLL_MS = 5_000
+const LOG_TAIL_LINES = 12
+const LOG_TAIL_MAX_CHARS = 1500
+
+export type SysAction = 'update' | 'restart'
+
+export interface SelfUpdatePaths {
+  script: string
+  resultFile: string
+  lockFile: string
+  logFile: string
+}
+
+// Paths come from agent.conf, which the pane sources before launching Claude.
+// Null when this is not a tg-agent install or the wrapper is not deployed yet.
+export function resolveSelfUpdatePaths(env: NodeJS.ProcessEnv): SelfUpdatePaths | null {
+  const ws = env.AGENT_WS
+  if (typeof ws !== 'string' || ws.length === 0) return null
+  const script = join(ws, 'bin', 'self-update.sh')
+  if (!existsSync(script)) return null
+  const logDir = env.LOG_DIR !== undefined && env.LOG_DIR.length > 0 ? env.LOG_DIR : join(ws, 'logs')
+  return {
+    script,
+    resultFile: join(ws, 'state', 'self-update.json'),
+    lockFile: join(ws, 'state', 'self-update.lock'),
+    logFile: join(logDir, 'self-update.log'),
+  }
+}
+
+// ───────────────────────────── confirm card
+
+export interface ParsedSysq {
+  action: SysAction | 'cancel'
+  ts: number | null
+  nonce: string | null
+}
+
+export function parseSysqCallback(data: string): ParsedSysq | null {
+  if (typeof data !== 'string' || !data.startsWith(SYSQ_PREFIX)) return null
+  const rest = data.slice(SYSQ_PREFIX.length)
+  if (rest === 'cancel') return { action: 'cancel', ts: null, nonce: null }
+  const m = /^(update|restart):(\d+):([a-z0-9]{1,16})$/.exec(rest)
+  if (m === null) return null
+  const ts = Number(m[2])
+  if (!Number.isSafeInteger(ts) || ts <= 0) return null
+  return { action: m[1] as SysAction, ts, nonce: `${m[2]}:${m[3]}` }
+}
+
+const CARD_TEXT: Record<SysAction, string> = {
+  update:
+    '<b>Обновление</b> — подтяну новую версию кита и перезапущусь. '
+    + 'Если новая версия не встанет, верну прежнюю. Продолжить?',
+  restart: '<b>Перезапуск</b> — агент перезапустится, текущая задача прервется. Продолжить?',
+}
+
+const CONFIRM_LABEL: Record<SysAction, string> = {
+  update: 'Да, обновить',
+  restart: 'Да, перезапустить',
+}
+
+export function buildSysConfirmCard(action: SysAction): {
+  text: string
+  inlineKeyboard: InlineKeyboardLike
+} {
+  const rand = Math.random().toString(36).slice(2, 10) || 'x'
+  return {
+    text: CARD_TEXT[action],
+    inlineKeyboard: {
+      inline_keyboard: [
+        [{ text: CONFIRM_LABEL[action], callback_data: `${SYSQ_PREFIX}${action}:${Date.now()}:${rand}` }],
+        [{ text: 'Отмена', callback_data: `${SYSQ_PREFIX}cancel` }],
+      ],
+    },
+  }
+}
+
+// ───────────────────────────── launch
+
+export type SpawnDetached = (
+  cmd: string,
+  args: string[],
+  logFile: string,
+  env: NodeJS.ProcessEnv,
+) => void
+
+// Real spawner: own session (setsid) so the restart's SIGHUP/kill of the pane
+// does not reach it; stdout+stderr appended to the log file.
+export const spawnDetached: SpawnDetached = (cmd, args, logFile, env) => {
+  mkdirSync(dirname(logFile), { recursive: true })
+  const fd = openSync(logFile, 'a')
+  try {
+    const child = spawn('setsid', [cmd, ...args], {
+      detached: true,
+      stdio: ['ignore', fd, fd],
+      env,
+    })
+    child.unref()
+  } finally {
+    closeSync(fd)
+  }
+}
+
+interface LockInfo {
+  ts: number
+  action?: SysAction
+  chat_id?: string
+}
+
+function readLock(file: string): LockInfo | null {
+  let raw: string
+  try {
+    raw = readFileSync(file, 'utf8').trim()
+  } catch {
+    return null
+  }
+  try {
+    const v = JSON.parse(raw) as unknown
+    if (typeof v === 'number') return { ts: v }
+    if (v !== null && typeof v === 'object' && typeof (v as LockInfo).ts === 'number') {
+      return v as LockInfo
+    }
+  } catch {
+    // fall through to mtime
+  }
+  try {
+    return { ts: statSync(file).mtimeMs }
+  } catch {
+    return null
+  }
+}
+
+function removeQuiet(file: string): void {
+  try {
+    unlinkSync(file)
+  } catch {
+    // already gone
+  }
+}
+
+export interface LaunchOptions {
+  spawn?: SpawnDetached
+  env?: NodeJS.ProcessEnv
+  chatId?: string
+}
+
+export type LaunchResult = { ok: true } | { ok: false; reason: 'busy' | 'spawn_failed'; error?: string }
+
+export function launchSelfUpdate(
+  action: SysAction,
+  paths: SelfUpdatePaths,
+  opts: LaunchOptions = {},
+): LaunchResult {
+  const lock = readLock(paths.lockFile)
+  if (lock !== null && Date.now() - lock.ts < SYSQ_LOCK_STALE_MS) {
+    return { ok: false, reason: 'busy' }
+  }
+  mkdirSync(dirname(paths.lockFile), { recursive: true })
+  removeQuiet(paths.resultFile)
+  const info: LockInfo = { ts: Date.now(), action }
+  if (opts.chatId !== undefined) info.chat_id = opts.chatId
+  writeFileSync(paths.lockFile, JSON.stringify(info))
+
+  const env: NodeJS.ProcessEnv = { ...(opts.env ?? process.env) }
+  // update.sh refuses to run inside the agent's own tmux session; the wrapper is
+  // detached from it, so drop the marker.
+  delete env.TMUX
+  delete env.TMUX_PANE
+  if (opts.chatId !== undefined) env.SELF_UPDATE_CHAT_ID = opts.chatId
+  try {
+    ;(opts.spawn ?? spawnDetached)('bash', [paths.script, action], paths.logFile, env)
+  } catch (err) {
+    removeQuiet(paths.lockFile)
+    return { ok: false, reason: 'spawn_failed', error: err instanceof Error ? err.message : String(err) }
+  }
+  return { ok: true }
+}
+
+// ───────────────────────────── report
+
+export interface SelfUpdateResult {
+  action: SysAction
+  rc: number
+  version?: string
+  chat_id?: string
+}
+
+function parseResult(raw: string): SelfUpdateResult | null {
+  try {
+    const v = JSON.parse(raw) as Partial<SelfUpdateResult>
+    if ((v.action !== 'update' && v.action !== 'restart') || typeof v.rc !== 'number') return null
+    return v as SelfUpdateResult
+  } catch {
+    return null
+  }
+}
+
+export function formatSelfUpdateReport(res: SelfUpdateResult, logTail: string): string {
+  if (res.action === 'restart') {
+    return res.rc === 0
+      ? '<b>Перезапустился</b>, на связи.'
+      : `<b>Перезапуск не удался</b> (код ${res.rc}).${tailBlock(logTail)}`
+  }
+  const ver = res.version !== undefined && res.version.length > 0
+    ? ` <code>${escapeHtml(res.version)}</code>`
+    : ''
+  if (res.rc === 0) return `<b>Обновился</b> до версии${ver}, на связи.`
+  return (
+    `<b>Обновление не прошло</b> (код ${res.rc}). Работаю на прежней версии.`
+    + tailBlock(logTail)
+  )
+}
+
+function tailBlock(tail: string): string {
+  const t = tail.trim()
+  return t.length === 0 ? '' : `\n\nКонец лога:\n<pre>${escapeHtml(t)}</pre>`
+}
+
+function readLogTail(file: string): string {
+  try {
+    const lines = readFileSync(file, 'utf8').split('\n')
+    const tail = lines.slice(-LOG_TAIL_LINES - 1).join('\n')
+    return tail.length > LOG_TAIL_MAX_CHARS ? tail.slice(-LOG_TAIL_MAX_CHARS) : tail
+  } catch {
+    return ''
+  }
+}
+
+export type SendOwner = (chatId: string, text: string) => Promise<void>
+
+// Report a finished run once. Claims the result by renaming it first, so two
+// plugin processes alive at the same moment cannot both send it. Returns true
+// when a report was sent.
+export async function reportSelfUpdateResult(
+  paths: SelfUpdatePaths,
+  ownerChatIds: readonly (number | string)[],
+  send: SendOwner,
+  log: Logger,
+): Promise<boolean> {
+  const claimed = `${paths.resultFile}.${process.pid}.claimed`
+  try {
+    renameSync(paths.resultFile, claimed)
+  } catch {
+    return false
+  }
+  let raw = ''
+  try {
+    raw = readFileSync(claimed, 'utf8')
+  } catch {
+    // vanished between rename and read
+  }
+  removeQuiet(claimed)
+  const lock = readLock(paths.lockFile)
+  removeQuiet(paths.lockFile)
+  const res = parseResult(raw)
+  if (res === null) {
+    log.warn('self-update result unreadable, dropped')
+    return false
+  }
+  const owners = ownerChatIds.map(String)
+  const wanted = res.chat_id ?? lock?.chat_id
+  const chatId = wanted !== undefined && owners.includes(wanted) ? wanted : owners[0]
+  if (chatId === undefined) {
+    log.warn('self-update result: no owner chat to report to')
+    return false
+  }
+  const tail = res.rc === 0 ? '' : readLogTail(paths.logFile)
+  try {
+    await send(chatId, formatSelfUpdateReport(res, tail))
+  } catch (err) {
+    log.warn('self-update report send failed', {
+      error: err instanceof Error ? err.message : String(err),
+    })
+    return false
+  }
+  log.info('self-update reported', { action: res.action, rc: res.rc })
+  return true
+}
+
+// Poll for the result for a bounded time. Started on boot (a restart or a
+// successful update lands here) and right after a launch (a failure before the
+// restart lands in the old process). Returns a stop function.
+export function watchSelfUpdateResult(
+  paths: SelfUpdatePaths,
+  ownerChatIds: readonly (number | string)[],
+  send: SendOwner,
+  log: Logger,
+  opts: { pollMs?: number; maxMs?: number } = {},
+): () => void {
+  const pollMs = opts.pollMs ?? SYSQ_POLL_MS
+  const deadline = Date.now() + (opts.maxMs ?? SYSQ_WATCH_MS)
+  let stopped = false
+  let timer: ReturnType<typeof setTimeout> | undefined
+  const tick = async (): Promise<void> => {
+    if (stopped) return
+    const done = await reportSelfUpdateResult(paths, ownerChatIds, send, log).catch(() => false)
+    if (done || Date.now() > deadline) return
+    if (!existsSync(paths.lockFile) && !existsSync(paths.resultFile)) return
+    timer = setTimeout(() => void tick(), pollMs)
+    timer.unref?.()
+  }
+  void tick()
+  return () => {
+    stopped = true
+    if (timer !== undefined) clearTimeout(timer)
+  }
+}
+
+// ───────────────────────────── callback
+
+export interface SysqCallbackContext {
+  callbackQuery: { data: string }
+  from?: { id?: number | undefined }
+  chatId?: string
+  answerCallbackQuery(arg?: { text: string }): Promise<void>
+  editMessageText(
+    text: string,
+    opts?: { parse_mode?: 'HTML'; reply_markup?: InlineKeyboardLike },
+  ): Promise<void>
+}
+
+export interface SysqCallbackDeps {
+  allowedUserIds: readonly number[]
+  ownerChatIds?: readonly (number | string)[]
+  paths: SelfUpdatePaths | null
+  log: Logger
+  launch?: (action: SysAction, paths: SelfUpdatePaths, opts: LaunchOptions) => LaunchResult
+  // Called after a successful launch so the live process watches for a result.
+  onLaunched?: () => void
+  nonceGuard?: NewqNonceGuard
+}
+
+const defaultGuard = createNewqNonceGuard()
+
+const LAUNCHED_TEXT: Record<SysAction, string> = {
+  update: '<b>Обновляюсь</b>. Обычно это пара минут, напишу, когда вернусь.',
+  restart: '<b>Перезапускаюсь</b>, вернусь через полминуты.',
+}
+
+export async function handleSysqCallback(
+  ctx: SysqCallbackContext,
+  deps: SysqCallbackDeps,
+): Promise<boolean> {
+  const fromId = ctx.from?.id
+  if (typeof fromId !== 'number' || !deps.allowedUserIds.includes(fromId)) {
+    deps.log.warn('sysq unauthorized tap', { user_id: fromId })
+    await ctx.answerCallbackQuery({ text: 'не авторизовано' })
+    return true
+  }
+  const parsed = parseSysqCallback(ctx.callbackQuery.data)
+  if (parsed === null) {
+    await ctx.answerCallbackQuery({ text: 'неизвестное действие' })
+    return true
+  }
+  if (parsed.action === 'cancel') {
+    await ctx.editMessageText('Отменено', { parse_mode: 'HTML' })
+    await ctx.answerCallbackQuery()
+    return true
+  }
+  const action = parsed.action
+  if (!isOwnerDmChat(ctx.chatId, deps.ownerChatIds)) {
+    await ctx.answerCallbackQuery({ text: 'недоступно в этом чате' })
+    return true
+  }
+  if (parsed.ts !== null && Date.now() - parsed.ts > SYSQ_TTL_MS) {
+    await ctx.answerCallbackQuery({ text: `запрос устарел, повтори /${action}` })
+    await ctx.editMessageText('Запрос устарел.', { parse_mode: 'HTML' })
+    return true
+  }
+  if (parsed.nonce !== null && !(deps.nonceGuard ?? defaultGuard).claim(parsed.nonce)) {
+    await ctx.answerCallbackQuery({ text: 'уже выполнено' })
+    return true
+  }
+  if (deps.paths === null) {
+    await ctx.answerCallbackQuery({ text: 'недоступно' })
+    await ctx.editMessageText(
+      'На этой установке нет скрипта обновления. Один раз обнови агента вручную '
+      + '(<code>./update.sh</code> из папки кита), дальше команда заработает.',
+      { parse_mode: 'HTML' },
+    )
+    return true
+  }
+  const opts: LaunchOptions = ctx.chatId !== undefined ? { chatId: ctx.chatId } : {}
+  const res = (deps.launch ?? launchSelfUpdate)(action, deps.paths, opts)
+  if (!res.ok) {
+    deps.log.warn('sysq launch failed', { action, reason: res.reason, error: res.error })
+    await ctx.answerCallbackQuery({ text: 'не запустилось' })
+    await ctx.editMessageText(
+      res.reason === 'busy'
+        ? 'Обновление или перезапуск уже идет, дождись результата.'
+        : 'Не смог запустить скрипт, подробности в логе плагина.',
+      { parse_mode: 'HTML' },
+    )
+    return true
+  }
+  deps.log.info('sysq launched', { action, chat_id: ctx.chatId })
+  await ctx.answerCallbackQuery({ text: 'Запускаю…' })
+  try {
+    await ctx.editMessageText(LAUNCHED_TEXT[action], {
+      parse_mode: 'HTML',
+      reply_markup: { inline_keyboard: [] },
+    })
+  } catch (err) {
+    deps.log.warn('sysq card edit failed (ignored)', {
+      error: err instanceof Error ? err.message : String(err),
+    })
+  }
+  deps.onLaunched?.()
+  return true
+}
