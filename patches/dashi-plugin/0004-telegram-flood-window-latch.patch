+    // the full retry_after, so it goes through and the latch has expired.
+    await clock.tick(2000)
+    await p
+    expect(stub.calls.map((c) => c.text)).toEqual(['hi'])
+    await api.sendMessage('100', 'later', {})
+    expect(stub.calls.map((c) => c.text)).toEqual(['hi', 'later'])
+  })
+
+  test('queued sends behind a failing op are refused, not sent into the ban', async () => {
+    const clock = new FakeClock()
+    const stub = makeStubApi(clock)
+    const api = createRateLimitedTelegramApi(stub.api, stubLog, defaultOpts(clock))
+    stub.queueError('sendMessage', make429Error(1020))
+    const first = api.sendMessage('100', 'first', {}).catch((e: unknown) => e)
+    const second = api.sendMessage('100', 'second', {}).catch((e: unknown) => e)
+    const [e1, e2] = await Promise.all([first, second])
+    expect((e1 as Error).name).toBe('TelegramFloodWaitError')
+    expect((e2 as Error).name).toBe('TelegramFloodWaitError')
+    expect(stub.calls.length).toBe(0)
+  })
+
+  // Race found in review: a send that already cleared the queue can sit in
+  // waitForCapacity while a NON-FIFO method (edit/reaction — they never join the
+  // tail chain) latches the chat. Without a gate right before the network call
+  // that send would land inside the flood window.
+  test('a send waiting for a token is refused if an edit latches the chat meanwhile', async () => {
+    const clock = new FakeClock()
+    const stub = makeStubApi(clock)
+    const opts = defaultOpts(clock)
+    opts.perChatBurstCapacity = 1
+    const api = createRateLimitedTelegramApi(stub.api, stubLog, opts)
+    // Burn the only token so the next send must wait for refill.
+    await api.sendMessage('100', 'first', {})
+    const waiting = api.sendMessage('100', 'must not land', {}).catch((e: unknown) => e)
+    await flushMicrotasks()
+    // While it waits, an edit hits a long 429 and latches the chat.
+    stub.queueError('editMessageText', make429Error(1020))
+    await api.editMessageText('100', 1, 'x', {}).catch(() => {})
+    // Token refills — the waiting send must now be refused, not sent.
+    await clock.tick(1000)
+    const err = (await waiting) as Error
+    expect(err.name).toBe('TelegramFloodWaitError')
+    expect(stub.calls.filter((c) => c.text === 'must not land').length).toBe(0)
+  })
+
+  test('retryBudgetS is configurable', async () => {
