+# Full scrollback + visible pane. Used ONLY on a redelivery, to look for
+# a unique id (delivery_id / message_id) the transcript may have scrolled
+# past. Never used for the busy footer: stale frames live in scrollback.
+pane_history() {
+  tmux capture-pane -t "$PANE" -p -J -S - 2>/dev/null || true
+}
+
+# The composer region: the composer prompt line (composer_line) and every
+# line below it (box border, footer hints). Claude Code draws the input
+# box at the bottom of the pane, so this is what is still unsent. Empty
+# when no composer is shown.
+composer_region() {
+  local n
+  n="$(composer_line "$1")"
+  (( n > 0 )) || return 0
+  awk -v n="$n" 'NR >= n' <<<"$1"
+}
+
+# Everything above the composer region: transcript, spinner, queued-message
+# display. A submitted prompt is echoed here. Empty when no composer is
+# shown — without a composer nothing can be told apart as "submitted".
+above_composer() {
+  local n
+  n="$(composer_line "$1")"
+  (( n > 1 )) || return 0
+  awk -v n="$n" 'NR < n' <<<"$1"
+}
+
+# count_fixed NEEDLE TEXT — occurrences of a fixed string (0 for empty).
+count_fixed() {
+  [[ -n "$1" ]] || { echo 0; return 0; }
+  local n
+  n="$(grep -oF -- "$1" <<<"$2" | wc -l)" || true
+  echo $((n))
+}
+
+# count_placeholders TEXT — Claude Code collapses a large paste into
+# `[Pasted text #N +M lines]`. Counted, never trusted by mere presence:
+# a stale one from an older paste can sit in the composer.
+count_placeholders() {
+  local n
+  n="$(grep -oiE '\[Pasted text #[0-9]+' <<<"$1" | wc -l)" || true
+  echo $((n))
+}
+
+# True when FP is a per-message unique id. Only such a fingerprint may be
+# looked up in history: a text fingerprint ("[from @user] да") can match
+# an older identical message and fake a delivery.
+fp_is_unique() {
+  [[ "$1" == delivery_id=* || "$1" == message_id=* ]]
+}
+
+# prompt_tail TEXT — the last <=30 characters of the last non-blank line
+# (UTF-8 safe). Proof that an uncollapsed second paste reached the
+# composer. Empty when there is nothing usable.
+prompt_tail() {
+  printf '%s' "$1" | python3 -c '
+import sys
+lines = [l.strip() for l in sys.stdin.read().splitlines() if l.strip()]
+if lines and len(lines[-1]) >= 4:
+    sys.stdout.write(lines[-1][-30:])
+' || true
+}
+
+# take_snapshot FP [TAIL] — one capture of the visible pane, split at the
+# composer. Sets globals:
+#   SNAP_FP_COMPOSER   occurrences of FP inside the composer region
+#   SNAP_PH_COMPOSER   paste placeholders inside the composer region
+#   SNAP_TAIL_COMPOSER occurrences of TAIL inside the composer region
+#   SNAP_FP_ABOVE      occurrences of FP above the composer (transcript)
+#   SNAP_BUSY          1 when the "esc to interrupt" footer is shown
+take_snapshot() {
+  local fp="$1" tail="${2:-}" out comp above
+  out="$(pane_text)"
+  comp="$(composer_region "$out")"
+  above="$(above_composer "$out")"
+  SNAP_FP_COMPOSER="$(count_fixed "$fp" "$comp")"
+  SNAP_PH_COMPOSER="$(count_placeholders "$comp")"
+  SNAP_TAIL_COMPOSER="$(count_fixed "$tail" "$comp")"
+  SNAP_FP_ABOVE="$(count_fixed "$fp" "$above")"
+  SNAP_BUSY=0
+  if grep -qiE 'esc to interrupt' <<<"$out"; then SNAP_BUSY=1; fi
+}
+
+# paste_text TEXT — one bracketed paste. Returns 2 on a tmux failure.
+paste_text() {
+  local buf="multichat-${CHAT_ID}-$$"
+  printf '%s' "$1" | tmux load-buffer -b "$buf" - || {
+    echo "multichat-entrypoint(watcher): load-buffer failed" >&2
+    return 2
+  }
+  tmux paste-buffer -d -t "$PANE" -b "$buf" -p || {
+    echo "multichat-entrypoint(watcher): paste-buffer failed" >&2
+    return 2
+  }
+}
+
+# press_enter_until_submitted FP FP_BASE PH_BASE PRE_GENERATING FP_ABOVE_BASE
+#
+# Enter-only verify loop; the body is never re-sent here. A submit counts
+# as confirmed only on POSITIVE evidence that THIS prompt left the
+# composer and became a turn:
+#   cleared — the composer holds no more copies of FP than FP_BASE and no
+#             more paste placeholders than PH_BASE (what was there before
+#             our paste), AND
+#   turn    — the busy footer appeared while no generation was running
+#             before (PRE_GENERATING=0), OR FP now shows above the
+#             composer more often than FP_ABOVE_BASE (the prompt echoed
+#             into the transcript / queued-message display).
+# "The fingerprint is gone" alone is NOT enough: a collapsed paste hides
+# the fingerprint from the start, so its absence proves nothing.
+# Returns 0 confirmed, 1 not confirmed.
+press_enter_until_submitted() {
+  local fp="$1" fp_base="$2" ph_base="$3" pre_generating="$4" above_base="$5"
+  local attempt delay
+  delay="$SUBMIT_RETRY_DELAY"
+  for ((attempt = 1; attempt <= SUBMIT_RETRY_MAX; attempt++)); do
+    # Re-check before every retry: a modal that appeared mid-flight must
+    # not collect our Enter as an answer.
+    if ! composer_visible; then
+      echo "multichat-entrypoint(watcher): composer disappeared mid-submit — stopping Enter retries" >&2
+      return 1
+    fi
+    tmux send-keys -t "$PANE" Enter || true
+    sleep "$delay"
+
+    if [[ -z "$fp" ]]; then
+      # Nothing to verify against (empty/whitespace-only body) — assume
+      # the Enter landed. Degraded path, equals the pre-fix behaviour.
+      return 0
+    fi
+    take_snapshot "$fp"
+    if (( SNAP_FP_COMPOSER <= fp_base && SNAP_PH_COMPOSER <= ph_base )); then
+      if [[ "$pre_generating" == "0" && "$SNAP_BUSY" == "1" ]] \
+          || (( SNAP_FP_ABOVE > above_base )); then
+        return 0
+      fi
+    fi
+
+    delay="$(awk -v d="$delay" -v f="$SUBMIT_RETRY_FACTOR" \
+      'BEGIN { printf "%.2f", d * f }')"
+  done
+
+  echo "multichat-entrypoint(watcher): submit not confirmed after ${SUBMIT_RETRY_MAX} attempts" >&2
+  return 1
+}
