-# True when the pane currently shows the Claude Code composer. The
-# composer renders a `❯` prompt char once the input handler is mounted;
-# a boot banner does not have one, and neither does a modal that has
-# grabbed the keyboard (survey, trust prompt, /model picker,
-# AskUserQuestion) — which is exactly the state where typing anything is
-# unsafe.
+# composer_line TEXT — 1-based line number of the composer prompt in a
+# pane capture, 0 when there is none. The composer is a `❯` at column 0
+# directly under a `───` separator (Claude Code frames its input box with
+# two of them). A `❯` anywhere else is not the composer:
+#   * inside our own pasted body — continuation lines are indented, and
+#     even a body line that starts with `❯` has no separator above it.
+#     Splitting the pane there (patch 0013 review) moved the fingerprint
+#     "above the composer" and a redelivery took it for a submitted turn;
+#   * a numbered menu pointer (`❯ 1. Yes`, rate-limit / AskUserQuestion)
+#     — an Enter there answers the menu.
+# A pane with no separator at all (older TUI, test stubs) falls back to
+# the last column-0 `❯` that is not a menu pointer.
+composer_line() {
+  awk '
+    /^───/ { seps = 1 }
+    /^❯/ && !/^❯[  ]*[0-9]+\./ {
+      any = NR
+      if (prev ~ /^───/) framed = NR
+    }
+    { prev = $0 }
+    END { print (framed ? framed : (seps ? 0 : (any ? any : 0))) }
+  ' <<<"$1"
+}
+
+# True when the pane currently shows the Claude Code composer. A boot
+# banner has none, and neither does a modal that has grabbed the
+# keyboard (survey, trust prompt, /model picker, AskUserQuestion) —
+# which is exactly the state where typing anything is unsafe.
 composer_visible() {
-  pane_text | grep -q '❯'
+  (( $(composer_line "$(pane_text)") > 0 ))
 }
 
