+# Full scrollback + visible pane. Used ONLY on a redelivery, to look for
+# a unique id (delivery_id / message_id) the transcript may have scrolled
+# past. Never used for the busy footer: stale frames live in scrollback.
+pane_history() {
+  tmux capture-pane -t "$PANE" -p -J -S - 2>/dev/null || true
+}
+
+# The composer region: the LAST line carrying the `❯` prompt and every
+# line below it (box border, footer hints). Claude Code draws the input
+# box at the bottom of the pane, so this is what is still unsent.
+composer_region() {
+  awk '/❯/ { buf = ""; found = 1 } found { buf = buf $0 "\n" } END { printf "%s", buf }' <<<"$1"
+}
+
+# Everything above the composer region: transcript, spinner, queued-message
+# display. A submitted prompt is echoed here.
+above_composer() {
+  awk '{ line[NR] = $0 } /❯/ { last = NR } END { for (i = 1; i < last; i++) print line[i] }' <<<"$1"
+}
+
+# count_fixed NEEDLE TEXT — occurrences of a fixed string (0 for empty).
+count_fixed() {
+  [[ -n "$1" ]] || { echo 0; return 0; }
+  local n
+  n="$(grep -oF -- "$1" <<<"$2" | wc -l)" || true
+  echo $((n))
