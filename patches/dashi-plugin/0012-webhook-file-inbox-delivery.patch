+// Webhook message delivery over the DM file inbox (patch 0012, 2026-10-08).
+//
+// Background. `POST /hooks/agent` with a `{message, chatId}` payload used to
+// be forwarded as an MCP notification and answered 200 as soon as the
+// notification call returned. The swarm worker treats any 2xx as "acked",
+// but an MCP notification can be dropped between the plugin and the model
+// with nothing reporting it: on 2026-10-08 10:48 UTC a maimozg -> bizmozg
+// task was acked and never seen.
+//
+// When the chat is in DM inbox mode (patch 0007: a state dir is configured
+// and the chat is in the list), the webhook now uses the same transport as
+// private DMs: one JSON file in `{stateDir}/chats/{chatId}/inbox/`, pasted
+// into the master pane by the attach-mode watcher with a verified Enter.
+// The file is written durably (fsync + rename + dir fsync) BEFORE the 200,
+// so "acked" now means "durably queued on this host".
+//
+// Fingerprint. The watcher verifies a submit by looking for a short,
+// per-message string on the pane. DMs have `message_id`; webhook messages
+// do not, and consecutive swarm tasks share a long identical prefix. Every
+// webhook delivery therefore gets a `delivery_id` attribute: the swarm task
+// nonce (for log correlation) plus a random suffix, so even a retried POST
+// of the same task never reuses an id still visible in the pane history.
+// It is deliberately NOT called message_id — the session must not mistake
+// it for a Telegram id usable with reply_to or react.
+
+import { randomBytes } from 'node:crypto'
+
+import { renderChannelBlock } from '../telegram/dm-inbox-delivery.js'
+import {
+  ensureChatStateDirs,
+  writeToInbox,
+  type InboundMessage,
+} from '../router/inbox-bridge.js'
+import type { Logger } from '../log.js'
+
+/** Random suffix bytes appended to a task nonce (8 hex chars). */
+const SUFFIX_BYTES = 4
+/** Random id bytes when the message carries no swarm task id (16 hex chars). */
+const FALLBACK_BYTES = 8
+/** Longest task nonce kept in the id; swarm nonces are 16 hex chars. */
+const MAX_NONCE_CHARS = 16
+
+// `swarm.ack(task_id="<from>::<to>::<nonce>")` as rendered by the swarm
+// worker. The last match wins: a quoted older task may precede it.
+const TASK_ID_RE = /swarm\.ack\(task_id="([^"]*)"/g
+
+export interface WebhookInboxOptions {
+  stateDir: string
+  chatId: string
+  content: string
+  agentId?: string
+  log: Logger
+}
+
+export interface WebhookInboxResult {
+  deliveryId: string
+  path: string
+}
+
+/** True when webhook messages for `chatId` must go through the file inbox. */
+export function isWebhookInboxChat(
+  stateDir: string | undefined,
+  chatIds: readonly string[] | undefined,
+  chatId: string,
+): stateDir is string {
+  return stateDir !== undefined && (chatIds ?? []).includes(chatId)
+}
+
+/**
+ * Build a unique, fingerprint-safe delivery id for one webhook message.
+ *
+ * Shape: `wh-<nonce>-<8 hex>` when the message carries a swarm task id,
+ * otherwise `wh-<16 hex>`. Only `[A-Za-z0-9_-]` survives from the nonce,
+ * so the id can never break out of its attribute or contain the space /
+ * `>` that end the watcher's fingerprint match.
+ */
+export function buildDeliveryId(message: string): string {
+  let taskId: string | undefined
+  for (const m of message.matchAll(TASK_ID_RE)) taskId = m[1]
+  const nonce = (taskId?.split('::').pop() ?? '')
+    .replace(/[^A-Za-z0-9_-]/g, '')
+    .slice(0, MAX_NONCE_CHARS)
+  if (nonce.length > 0) return `wh-${nonce}-${randomBytes(SUFFIX_BYTES).toString('hex')}`
+  return `wh-${randomBytes(FALLBACK_BYTES).toString('hex')}`
+}
+
+/**
+ * Durably commit one webhook message to the chat's file inbox.
+ *
+ * Resolves once the file is fsync'd and renamed into place; rejects on any
+ * failure. There is no MCP fallback on purpose: the caller answers 503 and
+ * the sender retries, which is safer than the lossy path this replaces.
+ */
+export async function deliverWebhookToInbox(
+  opts: WebhookInboxOptions,
+): Promise<WebhookInboxResult> {
+  const { stateDir, chatId, content, agentId, log } = opts
+  const deliveryId = buildDeliveryId(content)
+  // Same attributes the MCP path sends (source, chat_id, agent_id) plus the
+  // delivery id; renderChannelBlock escapes every value.
+  const meta: Record<string, string> = { source: 'webhook', chat_id: chatId }
+  if (agentId !== undefined) meta.agent_id = agentId
+  meta.delivery_id = deliveryId
+
+  await ensureChatStateDirs(chatId, stateDir)
+  const message: InboundMessage = {
+    text: renderChannelBlock(content, meta),
+    chat_id: chatId,
+    user_id: '',
+    // Empty: the watcher's build_prompt then pastes `text` verbatim.
+    user: '',
+    timestamp: new Date().toISOString(),
+  }
+  const path = await writeToInbox(chatId, message, stateDir, { durable: true })
+  log.info('webhook message committed to inbox', { chat_id: chatId, delivery_id: deliveryId })
+  return { deliveryId, path }
+}
