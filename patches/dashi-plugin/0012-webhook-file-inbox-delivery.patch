+/** Write + fsync a new file; on failure the partial tmp is removed. */
+async function writeFileSynced(path: string, body: string): Promise<void> {
+  const fh = await open(path, 'w', STATE_FILE_MODE)
+  let synced = false
+  try {
+    await fh.writeFile(body, { encoding: 'utf8' })
+    await fh.sync()
+    synced = true
+  } finally {
+    // The data is on disk once sync() returned; a close error after that
+    // cannot lose it, so it is not allowed to fail the commit.
+    await fh.close().catch(() => {})
+    if (!synced) await unlink(path).catch(() => {})
+  }
+}
+
+/**
+ * fsync a directory so a rename inside it is persisted. Best effort:
+ * some filesystems refuse fsync on a directory handle, and the file
+ * itself is already synced, so a failure here is not fatal.
+ */
+async function syncDir(dir: string): Promise<void> {
+  const fh = await open(dir, 'r').catch(() => null)
+  if (fh === null) return
+  await fh.sync().catch(() => {})
+  await fh.close().catch(() => {})
+}
