+// Webhook message payloads over the file inbox (patch 0012, 2026-10-08).
+//
+// Incident: 2026-10-08 10:48 UTC a swarm task maimozg -> bizmozg was POSTed
+// to /hooks/agent, answered 200, marked acked by the swarm worker — and
+// never reached the model. The MCP notification behind that 200 can be
+// dropped silently. When the target chat is in DM inbox mode the webhook
+// now commits the message as a file the attach-mode watcher injects with a
+// verified Enter, and answers 200 only after that commit is durable.
+
+import { afterEach, beforeEach, describe, expect, test } from 'bun:test'
+import { mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+
+import { getStatePaths, loadConfig, type AppConfig, type StatePaths } from '../../src/config.js'
+import { createLogger } from '../../src/log.js'
+import { ensureStateDirs } from '../../src/state/store.js'
+import { startWebhookServer, type WebhookServerHandle } from '../../src/webhook/server.js'
+import { buildDeliveryId } from '../../src/webhook/inbox-delivery.js'
+
+const FAKE_TOKEN = '123456789:AAH-fake_test_token_with_at_least_thirty_chars'
+const WEBHOOK_TOKEN = 'wh_test_token_32_chars__________'
+const CHAT_ID = '164795011'
+
+let stateDir: string
+let inboxRoot: string
+let paths: StatePaths
+let baseConfig: AppConfig
+let handle: WebhookServerHandle | null
+
+type Captured = { method: string; params: unknown }
+function makeMcpStub(): { server: any; calls: Captured[] } {
+  const calls: Captured[] = []
+  const server = {
+    notification: async (msg: { method: string; params: unknown }) => {
+      calls.push({ method: msg.method, params: msg.params })
+    },
+  }
+  return { server, calls }
+}
+
+beforeEach(() => {
+  stateDir = mkdtempSync(join(tmpdir(), 'dashi-webhook-inbox-'))
+  inboxRoot = join(stateDir, 'dm-inbox')
+  process.env.TELEGRAM_WEBHOOK_TOKEN = WEBHOOK_TOKEN
+  const env = { TELEGRAM_BOT_TOKEN: FAKE_TOKEN, TELEGRAM_STATE_DIR: stateDir }
+  baseConfig = loadConfig(env)
+  paths = getStatePaths(baseConfig, env)
+  ensureStateDirs(paths)
+  handle = null
+})
+
+afterEach(async () => {
+  if (handle) {
+    await handle.close()
+    handle = null
+  }
+  delete process.env.TELEGRAM_WEBHOOK_TOKEN
+  rmSync(stateDir, { recursive: true, force: true })
+})
+
+function config(): AppConfig {
+  return {
+    ...baseConfig,
+    webhook: { enabled: true, host: '127.0.0.1', port: 0 },
+  }
+}
+
+async function start(
+  inbox: { dmInboxStateDir?: string; dmInboxChatIds?: string[] },
+): Promise<ReturnType<typeof makeMcpStub>> {
+  const mcp = makeMcpStub()
+  const cfg = config()
+  const h = await startWebhookServer(cfg, {
+    mcpServer: mcp.server,
+    config: cfg,
+    statePaths: paths,
+    log: createLogger('test'),
+    ...inbox,
+  })
+  if (!h) throw new Error('expected handle')
+  handle = h
+  return mcp
+}
+
+async function post(message: string, chatId = CHAT_ID): Promise<Response> {
+  if (!handle) throw new Error('server not started')
+  return fetch(`http://${handle.host}:${handle.port}/hooks/agent`, {
+    method: 'POST',
+    headers: { Authorization: `Bearer ${WEBHOOK_TOKEN}`, 'Content-Type': 'application/json' },
+    body: JSON.stringify({ message, chatId: Number(chatId), agentId: 'dashi-channel' }),
+  })
+}
+
+function inboxDir(chatId = CHAT_ID): string {
+  return join(inboxRoot, 'chats', chatId, 'inbox')
+}
+
+function inboxFiles(chatId = CHAT_ID): string[] {
+  try {
+    return readdirSync(inboxDir(chatId)).filter((f) => f.endsWith('.json')).sort()
+  } catch {
+    return []
+  }
+}
+
+function readInbox(name: string, chatId = CHAT_ID): Record<string, unknown> {
+  return JSON.parse(readFileSync(join(inboxDir(chatId), name), 'utf8')) as Record<string, unknown>
+}
+
+const SWARM_TEXT =
+  'Задача от maimozg.\nswarm.ack(task_id="maimozg::bizmozg::0123456789abcdef")'
+
+describe('POST /hooks/agent in DM inbox mode', () => {
+  test('writes a committed inbox file and answers 200 without MCP', async () => {
+    const mcp = await start({ dmInboxStateDir: inboxRoot, dmInboxChatIds: [CHAT_ID] })
+    const resp = await post(SWARM_TEXT)
+    expect(resp.status).toBe(200)
+    const body = (await resp.json()) as Record<string, unknown>
+    expect(body.status).toBe('accepted')
+    expect(typeof body.delivery_id).toBe('string')
+
+    expect(mcp.calls.length).toBe(0)
+    const files = inboxFiles()
+    expect(files.length).toBe(1)
+    // No half-written tmp file left next to it.
+    expect(readdirSync(inboxDir()).some((f) => f.endsWith('.tmp'))).toBe(false)
+
+    const msg = readInbox(files[0]!)
+    expect(msg.chat_id).toBe(CHAT_ID)
+    // Empty `user` -> the watcher pastes `text` verbatim.
+    expect(msg.user).toBe('')
+    const text = String(msg.text)
+    expect(text.startsWith('<channel ')).toBe(true)
+    expect(text).toContain('source="webhook"')
+    expect(text).toContain(`chat_id="${CHAT_ID}"`)
+    expect(text).toContain('agent_id="dashi-channel"')
+    expect(text).toContain(`delivery_id="${String(body.delivery_id)}"`)
+    expect(text).toContain('swarm.ack(task_id="maimozg::bizmozg::0123456789abcdef")')
+    expect(text.endsWith('</channel>')).toBe(true)
+  })
+
+  test('a failed commit answers 503 so the worker retries — no MCP fallback', async () => {
+    // State dir is a regular file: mkdir under it fails.
+    const blocker = join(stateDir, 'not-a-dir')
+    writeFileSync(blocker, 'x')
+    const mcp = await start({ dmInboxStateDir: blocker, dmInboxChatIds: [CHAT_ID] })
+    const resp = await post(SWARM_TEXT)
+    expect(resp.status).toBe(503)
+    const body = (await resp.json()) as Record<string, unknown>
+    expect(body.error).toBe('inbox commit failed')
+    expect(mcp.calls.length).toBe(0)
+  })
+
+  test('a chat outside the inbox list keeps the MCP path', async () => {
+    const mcp = await start({ dmInboxStateDir: inboxRoot, dmInboxChatIds: ['555'] })
+    const resp = await post('hello via webhook')
+    expect(resp.status).toBe(200)
+    expect(mcp.calls.length).toBe(1)
+    const params = mcp.calls[0]!.params as { content: string; meta: Record<string, string> }
+    expect(params.content).toBe('hello via webhook')
+    expect(params.meta.source).toBe('webhook')
+    expect(params.meta.delivery_id).toBeUndefined()
+    expect(inboxFiles().length).toBe(0)
+  })
+
+  test('without an inbox state dir the MCP path is unchanged', async () => {
+    const mcp = await start({ dmInboxChatIds: [CHAT_ID] })
+    const resp = await post('hello via webhook')
+    expect(resp.status).toBe(200)
+    expect(mcp.calls.length).toBe(1)
+  })
+
+  test('every webhook message gets its own delivery_id, even a retried task', async () => {
+    await start({ dmInboxStateDir: inboxRoot, dmInboxChatIds: [CHAT_ID] })
+    const a = (await (await post(SWARM_TEXT)).json()) as Record<string, unknown>
+    const b = (await (await post(SWARM_TEXT)).json()) as Record<string, unknown>
+    expect(a.delivery_id).not.toBe(b.delivery_id)
+    const files = inboxFiles()
+    expect(files.length).toBe(2)
+    const ids = files.map((f) => /delivery_id="([^"]+)"/.exec(String(readInbox(f).text))?.[1])
+    expect(new Set(ids).size).toBe(2)
+  })
+})
+
+describe('buildDeliveryId', () => {
+  test('carries the swarm task nonce plus a random suffix', () => {
+    expect(buildDeliveryId(SWARM_TEXT)).toMatch(/^wh-0123456789abcdef-[0-9a-f]{8}$/)
+  })
+
+  test('falls back to a random id without a task_id', () => {
+    expect(buildDeliveryId('plain text')).toMatch(/^wh-[0-9a-f]{16}$/)
+  })
+
+  test('sanitizes a hostile nonce to the fingerprint-safe alphabet', () => {
+    const id = buildDeliveryId('swarm.ack(task_id="a::b::x\\"> <evil")')
+    expect(id).toMatch(/^wh-[A-Za-z0-9_-]+$/)
+  })
+
+  test('two calls never collide', () => {
+    expect(buildDeliveryId(SWARM_TEXT)).not.toBe(buildDeliveryId(SWARM_TEXT))
+  })
+})
