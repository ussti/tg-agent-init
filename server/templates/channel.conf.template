# tg-agent: channel secrets and plugin env. Written by install-server.sh with
# mode 600 into SECRETS_DIR (outside the repo and outside AGENT_HOME).
# Plain KEY=value lines; the agent pane sources this file with `set -a`.
TELEGRAM_BOT_TOKEN="{{BOT_TOKEN}}"
TELEGRAM_WEBHOOK_TOKEN="{{WEBHOOK_TOKEN}}"
TELEGRAM_PLUGIN_WEBHOOK_TOKEN="{{WEBHOOK_TOKEN}}"
TELEGRAM_STATE_DIR="{{AGENT_HOME}}/.claude/state/telegram"
TELEGRAM_CONFIG_FILE="{{AGENT_HOME}}/.claude/state/telegram/config.json"
TELEGRAM_EXPECTED_BOT_ID="{{BOT_ID}}"
TELEGRAM_ALLOWED_USER_IDS="{{OWNER_CHAT_ID}}"
TELEGRAM_ALLOWED_CHAT_IDS="{{OWNER_CHAT_ID}}"
TELEGRAM_WORKSPACE_ROOT="{{AGENT_HOME}}"
TELEGRAM_WEBHOOK_HOST="127.0.0.1"
TELEGRAM_WEBHOOK_PORT="{{WEBHOOK_PORT}}"
TELEGRAM_MEMORY_ENABLED="true"
TELEGRAM_MEMORY_WORKSPACE="{{AGENT_HOME}}/.claude"
TELEGRAM_MEMORY_LOGS_PATH="{{AGENT_HOME}}/.claude/logs"
TELEGRAM_MEMORY_SOURCE_TAG="tg"
TELEGRAM_MEMORY_AGENT_LABEL="{{AGENT_NAME}}"
TELEGRAM_ACCESS_MODE="allowlist"
TELEGRAM_STATUS_SIMPLE_TYPING="true"
AGENT_ID="{{AGENT_NAME}}"
