{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "200000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "75",
    "CLAUDE_CODE_EFFORT_LEVEL": "medium"
  },
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(jq *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(sudo *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Read({{SECRETS_DIR}}/**)",
      "Edit({{SECRETS_DIR}}/**)",
      "Write({{SECRETS_DIR}}/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "CLAUDE_PROJECT_DIR={{AGENT_HOME}} {{AGENT_WS}}/hooks/block-dangerous.sh", "timeout": 5 }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "CLAUDE_PROJECT_DIR={{AGENT_HOME}} {{AGENT_WS}}/hooks/protect-files.sh", "timeout": 5 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "CLAUDE_PROJECT_DIR={{AGENT_HOME}} {{AGENT_WS}}/hooks/log-commands.sh", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "{{AGENT_WS}}/hooks/post-to-webhook.sh", "timeout": 5 },
          { "type": "command", "command": "{{AGENT_WS}}/hooks/inject-channel-reminder.sh", "timeout": 5 },
          { "type": "command", "command": "CLAUDE_PROJECT_DIR={{AGENT_HOME}} node {{AGENT_WS}}/hooks/local-recall.mjs", "timeout": 10 },
          { "type": "command", "command": "CLAUDE_PROJECT_DIR={{AGENT_HOME}} {{AGENT_WS}}/hooks/correction-detector.sh", "timeout": 5 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "CLAUDE_PROJECT_DIR={{AGENT_HOME}} {{AGENT_WS}}/hooks/write-handoff.sh", "timeout": 10 },
          { "type": "command", "command": "{{AGENT_WS}}/hooks/post-to-webhook.sh", "timeout": 10 }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          { "type": "command", "command": "CLAUDE_PROJECT_DIR={{AGENT_HOME}} {{AGENT_WS}}/hooks/precompact-backup.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
